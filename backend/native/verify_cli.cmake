# No valid write command is issued; rejection happens before Core Audio starts.
execute_process(COMMAND "${NATIVE}" probe RESULT_VARIABLE code OUTPUT_VARIABLE reply TIMEOUT 4)
string(JSON protocol GET "${reply}" protocol)
string(JSON success GET "${reply}" success)
if(NOT code EQUAL 0 OR NOT protocol EQUAL 1 OR NOT success)
    message(FATAL_ERROR "Native probe failed")
endif()
function(reject)
    execute_process(COMMAND "${NATIVE}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE reply TIMEOUT 4)
    string(JSON protocol GET "${reply}" protocol)
    string(JSON success GET "${reply}" success)
    if(NOT code EQUAL 1 OR NOT protocol EQUAL 1 OR success)
        message(FATAL_ERROR "Invalid command was accepted: ${ARGN}")
    endif()
endfunction()
reject()
reject(unknown)
reject(status extra)
reject(probe extra)
reject(volume -1)
reject(volume 101)
reject(volume nan)
reject(volume inf)
reject(volume 30junk)
reject(volume 30 extra)
reject(delta 101)
reject(delta -101)
reject(mute 2)
reject(mute -1)
