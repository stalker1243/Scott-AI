<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Тесты запускаются и на сервере проверок, где окон нет вовсе.
         Поэтому здесь только то, что проверяется без окна: разбор, поиск
         файлов, хранение настроек и преобразователи значений. -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Avalonia без окна: нужна ради загрузчика ресурсов. Он
         регистрируется только запущенным приложением, а без него не
         проверить даже то, что иконки лежат по своим адресам — а на этом
         однажды не запустился весь выпуск. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScottAI_avalonia\ScottAI.Avalonia.csproj" />
  </ItemGroup>

</Project>
