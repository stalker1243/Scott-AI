{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScottAI",
  "version": "0.1.0",
  "identifier": "pro.lutushev.scottai",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ScottAI",
        "width": 1500,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "transparent": true,
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
