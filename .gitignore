# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment variables
.env
.env.local

# API Keys
*.key
*.pem

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Project specific
backend/answer.wav
backend/*.wav
backend/temp/
backend/models/
*.wav
*.mp3

# Rust build artifacts
target/


# .NET (лаунчер Avalonia) — промежуточные и собранные артефакты
[Bb]in/
[Oo]bj/

# Node / Tauri (прежний лаунчер ScottAI)
node_modules/
dist/

# Артефакты работы ассистента: кэш синтезированной речи и замеры этапов.
# Восстанавливаются сами при следующем запуске, в истории не нужны.
audio_cache/
logs/
backend/logs/

# Конфигурация ИИ хранит API-ключ, введённый пользователем через Настройки.
# Файл создаётся сам при первом сохранении, но в репозитории ему не место:
# иначе чужой ключ уедет в публичную историю первым же коммитом.
backend/data/ai_config.json

# Собранные отчёты об ошибках: содержат логи конкретного запуска и нужны
# только для отправки разработчику.
reports/

# Сборка дистрибутива: встроенный Python, собранный лаунчер и скачанные архивы.
# Всё это получается из исходников командой installer/build.py.
installer/dist/
installer/.cache/
# Собранный установщик — артефакт выпуска: его место в GitHub Releases, а не
# в истории репозитория (61 МБ на каждую сборку).
installer/release/
# И любой собранный установщик, где бы он ни оказался: Inno Setup кладёт его
# рядом со скриптом, если запустить его вручную, и 60 МБ уезжали в историю.
installer/*.exe

# Данные конкретной машины: профили, макросы, напоминания, история разговоров
# и выученные ответы. Чужому человеку они не нужны, а в публичном репозитории
# это ещё и личная переписка владельца. Программа создаёт их сама при первом
# запуске (см. _ensure_data_dir в main.py).
backend/data/
backend/*_memory.json

# Рабочие заметки по проекту: как он устроен внутри, на чём уже обжигались,
# что проверять при правках. Это записи для развития проекта, а не
# документация для тех, кто им пользуется, — поэтому файл остаётся на диске,
# но в репозиторий не уезжает.
CLAUDE.md
DEV_NOTES.md

# Ручные пробы времён разработки: не часть набора тестов (тот в
# backend/tests), запускаются руками и требуют живого сервера.
/test_greetings.py
/test_voice_flow.py
