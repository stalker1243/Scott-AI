*$py.class
*.so
.Python
env/
venv/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Environment variables
.env
.env.local

# API Keys
*.key
*.pem

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Project specific
backend/answer.wav
backend/*.wav
backend/temp/
backend/models/
*.wav
*.mp3

# Rust build artifacts
target/


# .NET (лаунчер Avalonia) — промежуточные и собранные артефакты
[Bb]in/
[Oo]bj/

# Node / Tauri (прежний лаунчер ScottAI)
node_modules/
dist/

# Артефакты работы ассистента: кэш синтезированной речи и замеры этапов.
# Восстанавливаются сами при следующем запуске, в истории не нужны.
audio_cache/
logs/
backend/logs/

# Конфигурация ИИ хранит API-ключ, введённый пользователем через Настройки.
# Файл создаётся сам при первом сохранении, но в репозитории ему не место:
# иначе чужой ключ уедет в публичную историю первым же коммитом.
backend/data/ai_config.json

# Собранные отчёты об ошибках: содержат логи конкретного запуска и нужны
# только для отправки разработчику.
reports/

# Сборка дистрибутива: встроенный Python, собранный лаунчер и скачанные архивы.
# Всё это получается из исходников командой installer/build.py.
installer/dist/
installer/.cache/
# Собранный установщик — артефакт выпуска: его место в GitHub Releases, а не
# в истории репозитория (61 МБ на каждую сборку).
installer/release/
