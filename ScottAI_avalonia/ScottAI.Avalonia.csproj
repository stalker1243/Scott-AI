<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Имя файла программы. Пространство имён остаётся прежним, а вот в
         проводнике, диспетчере задач и списке «приложения, использующие
         файлы» человек должен видеть просто ScottAI, а не название
         UI-библиотеки, которой он не выбирал. -->
    <AssemblyName>ScottAI</AssemblyName>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Иконка самого .exe — в проводнике, на панели задач и в списке
         установленных программ. Свойство Window.Icon отвечает только за
         заголовок окна, файл в проводнике остаётся с иконкой по умолчанию. -->
    <ApplicationIcon>Assets\scott.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Иконки: без явного объявления Avalonia не находит их в ресурсах, и
         приложение падает при старте на TrayIcon с FileNotFoundException. -->
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
  </ItemGroup>
</Project>
