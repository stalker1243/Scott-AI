<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Avalonia.ViewModels"
             xmlns:conv="using:ScottAI.Avalonia.Converters"
             xmlns:holo="using:ScottAI.Avalonia.Hologram"
             x:DataType="vm:HomeViewModel"
             x:Class="ScottAI.Avalonia.Views.HologramView">

    <!-- Голограмма состояния машины.

         Каждая часть фигуры отвечает за свою подсистему, и это не украшение:
         человек должен одним взглядом понять, что происходит, не читая цифр.
         Голова — видеокарта (на ней живут распознавание и синтез речи), ядро в
         груди — процессор, корпус — оперативная память, ноги — диск.

         Фигура объёмная, её можно крутить мышью. Плащ и отделка ничего не
         показывают и красятся нейтрально: иначе каждая складка спорила бы с
         показаниями за внимание. -->

    <UserControl.Styles>
        <!-- Дыхание проекции: лёгкое колебание яркости. Дольше четырёх секунд —
             иначе мерцание начинает раздражать боковое зрение, а мигать
             интерфейс не должен. -->
        <Style Selector="Grid.figure">
            <Style.Animations>
                <Animation Duration="0:0:4.0" IterationCount="INFINITE">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.9" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1.0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Луч развёртки: тонкая полоса, бегущая по фигуре сверху вниз.
             Именно она делает картинку живой — без движения это просто схема. -->
        <Style Selector="Rectangle.scanline">
            <Style.Animations>
                <Animation Duration="0:0:4.5" IterationCount="INFINITE" Easing="LinearEasing">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-10" />
                    </KeyFrame>
                    <KeyFrame Cue="12%"><Setter Property="Opacity" Value="0.5" /></KeyFrame>
                    <KeyFrame Cue="88%"><Setter Property="Opacity" Value="0.5" /></KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="400" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Основание проекции: круги расходятся, будто фигуру и правда
             откуда-то проецируют. -->
        <Style Selector="Ellipse.pedestal">
            <Style.Animations>
                <Animation Duration="0:0:3.0" IterationCount="INFINITE" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.5" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="LetterSpacing" Value="1.2" />
        </Style>

        <Style Selector="TextBlock.reading">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.6" />
                </Transitions>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,Auto,*" MinHeight="440">

        <!-- ==================== Подписи слева ==================== -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Right"
                    Spacing="52" Margin="0,0,18,0">

            <StackPanel Spacing="2" HorizontalAlignment="Right">
                <TextBlock Text="ВИДЕОКАРТА" Classes="caption" HorizontalAlignment="Right" />
                <TextBlock Classes="reading" HorizontalAlignment="Right"
                           Text="{Binding GpuPercent, StringFormat={}{0:0}%}"
                           Foreground="{Binding GpuPercent, Converter={x:Static conv:LoadToBrushConverter.Instance}}" />
                <TextBlock Text="голова · распознавание и синтез речи" FontSize="10"
                           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
            </StackPanel>

            <StackPanel Spacing="2" HorizontalAlignment="Right">
                <TextBlock Text="ПАМЯТЬ" Classes="caption" HorizontalAlignment="Right" />
                <TextBlock Classes="reading" HorizontalAlignment="Right"
                           Text="{Binding RamPercent, StringFormat={}{0:0}%}"
                           Foreground="{Binding RamPercent, Converter={x:Static conv:LoadToBrushConverter.Instance}}" />
                <TextBlock Text="корпус" FontSize="10"
                           Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
            </StackPanel>
        </StackPanel>

        <!-- ==================== Сама фигура ==================== -->
        <Grid Grid.Column="1" Classes="figure" Width="260" Height="440" RowDefinitions="*,Auto">

            <Grid Grid.Row="0">
                <!-- Свечение вокруг фигуры: без него она выглядит наклейкой, а не
                     проекцией в воздухе. -->
                <Ellipse Width="230" Height="360" VerticalAlignment="Center" Opacity="0.10"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#22D3EE" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <holo:HologramCanvas Name="Figure"
                                     Gpu="{Binding GpuPercent}"
                                     Cpu="{Binding CpuPercent}"
                                     Ram="{Binding RamPercent}"
                                     Disk="{Binding DiskPercent}"
                                     Suit="{Binding Suit}"
                                     ToolTip.Tip="Потяните мышью, чтобы повернуть" />

                <!-- Луч развёртки поверх фигуры -->
                <Rectangle Classes="scanline" Height="2" VerticalAlignment="Top"
                           Margin="20,0" IsHitTestVisible="False">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Offset="0" Color="Transparent" />
                            <GradientStop Offset="0.5" Color="#7DD3FC" />
                            <GradientStop Offset="1" Color="Transparent" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                    <Rectangle.RenderTransform>
                        <TranslateTransform />
                    </Rectangle.RenderTransform>
                </Rectangle>

                <!-- Кольца проекции у ног.

                     Выравниваются по центру, а не по абсолютным координатам:
                     фигура центрируется по своему полю, и зашитые числа
                     оставляли её стоящей рядом с кольцом, а не в нём. -->
                <Grid IsHitTestVisible="False" VerticalAlignment="Bottom" Margin="0,0,0,6">
                    <Ellipse Width="144" Height="34" HorizontalAlignment="Center" Fill="Transparent"
                             StrokeThickness="1.2" Opacity="0.45" Stroke="#22D3EE" />
                    <Ellipse Classes="pedestal" Width="188" Height="50" HorizontalAlignment="Center"
                             Fill="Transparent" StrokeThickness="1" Stroke="#22D3EE" />
                </Grid>
            </Grid>

            <!-- Выбор костюма. Два вида — не ради разнообразия: это первое, что
                 человек показывает другим, открыв программу. -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
                        HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="Броня" Classes="tab" FontSize="11" Padding="12,5"
                        Command="{Binding SetSuitCommand}" CommandParameter="Armor"
                        Classes.tabactive="{Binding IsArmorSuit}" />
                <Button Content="Плащ" Classes="tab" FontSize="11" Padding="12,5"
                        Command="{Binding SetSuitCommand}" CommandParameter="Cloak"
                        Classes.tabactive="{Binding !IsArmorSuit}" />
            </StackPanel>
        </Grid>

        <!-- ==================== Подписи справа ==================== -->
        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left"
                    Spacing="52" Margin="18,0,0,0">

            <StackPanel Spacing="2">
                <TextBlock Text="ПРОЦЕССОР" Classes="caption" />
                <TextBlock Classes="reading"
                           Text="{Binding CpuPercent, StringFormat={}{0:0}%}"
                           Foreground="{Binding CpuPercent, Converter={x:Static conv:LoadToBrushConverter.Instance}}" />
                <TextBlock Text="{Binding ProcessCount, StringFormat={}ядро · {0} процессов}" FontSize="10"
                           Foreground="{DynamicResource TextMuted}" />
            </StackPanel>

            <StackPanel Spacing="2">
                <TextBlock Text="ДИСК" Classes="caption" />
                <TextBlock Classes="reading"
                           Text="{Binding DiskPercent, StringFormat={}{0:0}%}"
                           Foreground="{Binding DiskPercent, Converter={x:Static conv:LoadToBrushConverter.Instance}}" />
                <TextBlock Text="ноги · занято на системном" FontSize="10"
                           Foreground="{DynamicResource TextMuted}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
