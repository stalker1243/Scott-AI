<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Avalonia.ViewModels"
             xmlns:models="using:ScottAI.Avalonia.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:DataType="vm:ProjectsViewModel"
             x:Class="ScottAI.Avalonia.Views.ProjectsView">

    <!-- Проекты.

         Список сам по себе бесполезен — такой заводят в блокноте. Польза в
         том, что им пользуется Scott: открывает папку по названию и держит
         текущий проект в уме, отвечая на вопросы о работе. -->

    <ScrollViewer>
        <StackPanel Margin="32,28" Spacing="16" MaxWidth="760" HorizontalAlignment="Left">

            <!-- ==================== Новый проект ==================== -->

            <Button Command="{Binding StartAddingCommand}" Classes="accent" Padding="16,10"
                    HorizontalAlignment="Left" IsVisible="{Binding !Adding}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <mi:MaterialIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                    <TextBlock Text="Новый проект" />
                </StackPanel>
            </Button>

            <Border IsVisible="{Binding Adding}" Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="12" Padding="18,16" MinWidth="640">
                <StackPanel Spacing="12">
                    <TextBox Text="{Binding NewName}" PlaceholderText="Название — им же вы позовёте проект голосом" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Text="{Binding NewPath}"
                                 PlaceholderText="Папка с работой (необязательно)" />
                        <Button Grid.Column="1" Content="Выбрать…" Classes="soft" Click="OnPickFolderClick" />
                    </Grid>

                    <TextBox Text="{Binding NewStack}" PlaceholderText="На чём написан — например, C# и Avalonia" />
                    <TextBox Text="{Binding NewNote}" PlaceholderText="Заметка: что это за проект (необязательно)" />

                    <TextBlock Text="Название, стек и заметку Scott учитывает в ответах, когда этот проект выбран текущим."
                               FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                        <Button Content="Отмена" Command="{Binding CancelAddingCommand}" Classes="soft" />
                        <Button Content="Завести" Command="{Binding AddCommand}" Classes="accent" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================== Список ==================== -->

            <!-- Нижняя граница ширины: без неё список сжимается по содержимому,
                 и кнопки справа липнут к названию вместо того, чтобы стоять у
                 края карточки. -->
            <ItemsControl ItemsSource="{Binding Projects}" MinWidth="640">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Project">
                        <Border Background="{DynamicResource BgSurface}" BorderThickness="1"
                                CornerRadius="12" Padding="16,14" Margin="0,0,0,10"
                                BorderBrush="{DynamicResource BorderColor}"
                                Classes.current="{Binding Current}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <!-- Квадратик с буквой: значка у проекта нет и
                                     взяться ему неоткуда, а ряд одинаковых строк
                                     читается хуже, чем ряд с опознавательными
                                     знаками. -->
                                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="11"
                                        Background="{DynamicResource BgElevated}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Accent}" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimary}" />

                                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="6"
                                                Padding="7,2" VerticalAlignment="Center"
                                                IsVisible="{Binding Current}">
                                            <TextBlock Text="сейчас в работе" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent}" />
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Stack}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}"
                                               IsVisible="{Binding Stack, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                                    <TextBlock Text="{Binding Note}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMuted}"
                                               IsVisible="{Binding Note, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                                    <!-- Папка могла переехать или исчезнуть уже
                                         после того, как проект завели. Честнее
                                         сказать сразу, чем молча не открыть. -->
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding PathMissing}">
                                        <mi:MaterialIcon Kind="AlertOutline" Width="12" Height="12"
                                                         VerticalAlignment="Center"
                                                         Foreground="{DynamicResource Danger}" />
                                        <TextBlock Text="папка не найдена" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Danger}" />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Path}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMuted}"
                                               IsVisible="{Binding !PathMissing}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <Button Classes="soft" Padding="10,7"
                                            Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).OpenCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding !PathMissing}"
                                            ToolTip.Tip="Открыть папку">
                                        <mi:MaterialIcon Kind="FolderOpenOutline" Width="15" Height="15" />
                                    </Button>

                                    <Button Classes="soft" Padding="10,7"
                                            Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).MakeCurrentCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding !Current}"
                                            ToolTip.Tip="Работаю сейчас над ним">
                                        <mi:MaterialIcon Kind="CheckboxMarkedCircleOutline" Width="15" Height="15" />
                                    </Button>

                                    <Button Padding="10,7" Background="Transparent" BorderThickness="0"
                                            Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).ForgetCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Забыть проект (папка останется)">
                                        <mi:MaterialIcon Kind="Close" Width="14" Height="14"
                                                         Foreground="{DynamicResource TextMuted}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Пусто — обычное начало, а не беда. -->
            <Border IsVisible="{Binding IsEmpty}" Background="{DynamicResource BgSurface}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="12" Padding="28" MinWidth="640">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <mi:MaterialIcon Kind="FolderMultipleOutline" Width="30" Height="30"
                                     HorizontalAlignment="Center"
                                     Foreground="{DynamicResource TextMuted}" />
                    <TextBlock Text="Проектов пока нет" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" FontSize="12"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"
                               Text="Заведите проект — и сможете сказать «открой проект такой-то», а Scott будет учитывать вашу работу в ответах." />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}"
                       IsVisible="{Binding Error, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
