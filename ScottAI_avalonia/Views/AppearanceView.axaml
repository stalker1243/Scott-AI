<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Avalonia.ViewModels"
             xmlns:myconv="using:ScottAI.Avalonia.Converters"
             x:DataType="vm:AppearanceViewModel"
             x:Class="ScottAI.Avalonia.Views.AppearanceView">

    <!-- Внешний вид.

         Оформление перебирают, глядя на программу: включил светлую тему,
         посмотрел, вернул тёмную. Поэтому оно и стало отдельным разделом, а не
         третьей вкладкой внутри Настроек, куда заходят с вопросом. -->

    <ScrollViewer>
        <StackPanel Margin="32,28" Spacing="26" MaxWidth="620" HorizontalAlignment="Left">

            <!-- ==================== Стиль ==================== -->

            <StackPanel Spacing="10">
                <TextBlock Text="Стиль" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Text="Classic — обычное окно, Glass — с настоящим размытием рабочего стола под ним, Terminal Pro — строгий и плоский, Dashboard — тёплый графит с янтарём, вид приборной панели."
                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Classic" Command="{Binding SetStyleClassicCommand}" Classes="tab"
                            Classes.tabactive="{Binding CurrentStyle, Converter={x:Static myconv:EqualsConverter.Instance}, ConverterParameter=classic}" />
                    <Button Content="Glass" Command="{Binding SetStyleGlassCommand}" Classes="tab"
                            Classes.tabactive="{Binding CurrentStyle, Converter={x:Static myconv:EqualsConverter.Instance}, ConverterParameter=glass}" />
                    <Button Content="Terminal Pro" Command="{Binding SetStyleTerminalCommand}" Classes="tab"
                            Classes.tabactive="{Binding CurrentStyle, Converter={x:Static myconv:EqualsConverter.Instance}, ConverterParameter=terminal}" />
                    <Button Content="Dashboard" Command="{Binding SetStyleDashboardCommand}" Classes="tab"
                            Classes.tabactive="{Binding CurrentStyle, Converter={x:Static myconv:EqualsConverter.Instance}, ConverterParameter=dashboard}" />
                </StackPanel>
            </StackPanel>

            <!-- Тема есть только у Classic: у Glass её задаёт рабочий стол под
                 окном, а Terminal Pro тёмный по замыслу. -->
            <StackPanel Spacing="10" IsVisible="{Binding CurrentStyle, Converter={x:Static myconv:EqualsConverter.Instance}, ConverterParameter=classic}">
                <TextBlock Text="Тема" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Тёмная" Command="{Binding SetDarkCommand}" Classes="soft"
                            Classes.tabactive="{Binding IsDark}" />
                    <Button Content="Светлая" Command="{Binding SetLightCommand}" Classes="soft"
                            Classes.tabactive="{Binding !IsDark}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="10" IsVisible="{Binding CurrentStyle, Converter={x:Static myconv:EqualsConverter.Instance}, ConverterParameter=glass}">
                <TextBlock Text="Прозрачность окна" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Text="Настоящее размытие рабочего стола под окном — двигайте, чтобы подобрать баланс между читаемостью и прозрачностью."
                           FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,Auto">
                    <Slider Grid.Column="0" Minimum="15" Maximum="100" Value="{Binding GlassOpacity}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding GlassOpacity, StringFormat={}{0:0}%}" Width="48"
                               HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                </Grid>
            </StackPanel>

            <!-- ==================== Цвет ==================== -->

            <StackPanel Spacing="10">
                <TextBlock Text="Акцентный цвет" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock Text="Тот же выбор есть в углу окна, кнопкой с палитрой — чтобы не уходить со страницы, которую разглядываете."
                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
                <ItemsControl ItemsSource="{Binding AccentSwatches}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccentSwatch">
                            <Button Width="36" Height="36" CornerRadius="18" Padding="0" Classes="swatch"
                                    Classes.selected="{Binding IsSelected}"
                                    Background="{Binding Hex, Converter={x:Static myconv:HexToBrushConverter.Instance}}"
                                    Command="{Binding $parent[ItemsControl].((vm:AppearanceViewModel)DataContext).SetAccentCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ==================== Значок ==================== -->

            <StackPanel Spacing="10">
                <TextBlock Text="Значок программы" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMuted}"
                           Text="Меняется значок в трее, заголовке окна и логотип слева. Выберите белый знак на чёрном фоне или чёрный на белом. Выбор не зависит от темы окна. Значок файла программы всегда тёмный: он вшит при сборке." />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Classes="iconpick" AutomationProperties.Name="Тёмный значок"
                            Command="{Binding SetIconCommand}" CommandParameter="dark"
                            Classes.tabactive="{Binding IconVariant, Converter={x:Static myconv:EqualsConverter.Instance}, ConverterParameter=dark}">
                        <StackPanel Spacing="6">
                            <Image Source="/Assets/scott-logo.png" Width="56" Height="56" />
                            <TextBlock Text="Тёмный" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Classes="iconpick" AutomationProperties.Name="Светлый значок"
                            Command="{Binding SetIconCommand}" CommandParameter="light"
                            Classes.tabactive="{Binding IconVariant, Converter={x:Static myconv:EqualsConverter.Instance}, ConverterParameter=light}">
                        <StackPanel Spacing="6">
                            <Image Source="/Assets/scott-logo-light.png" Width="56" Height="56" />
                            <TextBlock Text="Светлый" FontSize="12" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
