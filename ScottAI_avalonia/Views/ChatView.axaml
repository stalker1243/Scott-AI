<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Avalonia.ViewModels"
             xmlns:models="using:ScottAI.Avalonia.Models"
             xmlns:conv="using:ScottAI.Avalonia.Converters"
             xmlns:aconv="using:Avalonia.Data.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:DataType="vm:ChatViewModel"
             x:Class="ScottAI.Avalonia.Views.ChatView">
    <UserControl.Styles>
        <!-- Индикатор "Scott печатает" — три подпрыгивающие точки со сдвигом по фазе. -->
        <Style Selector="Ellipse.typingdot">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="Fill" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="Ellipse.typingdot.dot1">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="30%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.typingdot.dot2">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE" Delay="0:0:0.15">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="30%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Ellipse.typingdot.dot3">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE" Delay="0:0:0.3">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="30%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid Margin="24" RowDefinitions="Auto,*,Auto,Auto">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock Grid.Column="0" Text="Чат со Scott" FontSize="20" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Classes="soft" Command="{Binding ToggleHistoryCommand}" Classes.tabactive="{Binding ShowHistory}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="History" Width="16" Height="16" />
                        <TextBlock Text="История" />
                    </StackPanel>
                </Button>
                <Button Classes="soft" Classes.tabactive="{Binding QuietMode}" Command="{Binding ToggleQuietModeCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="{Binding QuietMode, Converter={x:Static conv:ChatVoiceIconConverter.Instance}}" Width="16" Height="16" />
                        <TextBlock Text="{Binding QuietMode, Converter={x:Static conv:ChatVoiceLabelConverter.Instance}}" />
                    </StackPanel>
                </Button>
                <Button Classes="soft" Command="{Binding NewChatCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="PlusCircleOutline" Width="16" Height="16" />
                        <TextBlock Text="Новый чат" />
                    </StackPanel>
                </Button>
                <!-- «Новый чат» очищает окно, а это — саму память Scott. -->
                <Button Classes="soft" Command="{Binding ClearHistoryCommand}"
                        ToolTip.Tip="Scott забудет разговор целиком">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <mi:MaterialIcon Kind="DeleteOutline" Width="16" Height="16" />
                        <TextBlock Text="Удалить историю" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
            <Border Grid.Column="0" IsVisible="{Binding ShowHistory}" Width="220" Margin="0,0,12,0"
                    Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="12" Padding="10">
                <StackPanel Spacing="6">
                    <TextBlock Text="Промты этой сессии" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondary}" Margin="4,2,4,4" />
                    <ScrollViewer MaxHeight="480">
                        <ItemsControl ItemsSource="{Binding PromptHistory}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Classes="soft" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Margin="0,2" Padding="10,8"
                                            Command="{Binding $parent[ItemsControl].((vm:ChatViewModel)DataContext).SelectHistoryPromptCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" FontSize="12" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Column="1" Name="Scroller">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ChatMessage">
                                <Border Margin="0,4" Padding="14,10" CornerRadius="12"
                                        Background="{Binding FromUser, Converter={x:Static conv:FromUserToBrushConverter.Instance}}"
                                        MaxWidth="560"
                                        HorizontalAlignment="{Binding FromUser, Converter={x:Static conv:FromUserToAlignmentConverter.Instance}}">
                                    <StackPanel Spacing="4">
                                        <Border IsVisible="{Binding AttachmentName, Converter={x:Static aconv:ObjectConverters.IsNotNull}, FallbackValue=False}"
                                                Background="{DynamicResource BgElevated}" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <mi:MaterialIcon Kind="Paperclip" Width="13" Height="13" Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="{Binding AttachmentName}" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Сообщение показывается кусками: обычный текст и блоки кода.
                                             У кода своя рамка, моноширинный шрифт и кнопка «Копировать» —
                                             выделять программу мышью по строчкам неудобно. -->
                                        <ItemsControl ItemsSource="{Binding Segments}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:MessageSegment">
                                                    <Panel>
                                                        <SelectableTextBlock IsVisible="{Binding IsText}"
                                                                             Text="{Binding Text}" TextWrapping="Wrap"
                                                                             Foreground="{DynamicResource TextPrimary}" />

                                                        <Border IsVisible="{Binding IsCode}" Margin="0,6"
                                                                Background="{DynamicResource BgElevated}"
                                                                BorderBrush="{DynamicResource BorderColor}"
                                                                BorderThickness="1" CornerRadius="8">
                                                            <Grid RowDefinitions="Auto,Auto">
                                                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="10,6,6,2">
                                                                    <TextBlock Grid.Column="0" Text="{Binding Caption}"
                                                                               FontSize="11" VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource TextMuted}" />
                                                                    <Button Grid.Column="1" Classes="soft" Padding="8,3"
                                                                            Click="OnCopyCodeClick" ToolTip.Tip="Скопировать код">
                                                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                                                            <mi:MaterialIcon Kind="ContentCopy" Width="13" Height="13" />
                                                                            <TextBlock Text="Копировать" FontSize="11" />
                                                                        </StackPanel>
                                                                    </Button>
                                                                </Grid>
                                                                <ScrollViewer Grid.Row="1" MaxHeight="320"
                                                                              HorizontalScrollBarVisibility="Auto"
                                                                              VerticalScrollBarVisibility="Auto">
                                                                    <SelectableTextBlock Text="{Binding Text}" Margin="10,2,10,10"
                                                                                         FontFamily="Consolas,Menlo,Monospace"
                                                                                         FontSize="12.5"
                                                                                         Foreground="{DynamicResource TextPrimary}" />
                                                                </ScrollViewer>
                                                            </Grid>
                                                        </Border>
                                                    </Panel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding Time}" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border IsVisible="{Binding Sending}" Margin="0,4" Padding="16,13" CornerRadius="12"
                            Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Classes="typingdot dot1" />
                            <Ellipse Classes="typingdot dot2" />
                            <Ellipse Classes="typingdot dot3" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" IsVisible="{Binding HasAttachment}" Margin="0,10,0,0"
                Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource Accent}"
                BorderThickness="1" CornerRadius="8" Padding="10,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <mi:MaterialIcon Grid.Column="0" Kind="Paperclip" Width="16" Height="16"
                                  Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding AttachedImageName}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding AttachedImageName, Converter={x:Static aconv:ObjectConverters.IsNotNull}}" />
                <TextBlock Grid.Column="1" Text="{Binding AttachedFileName}" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding AttachedFileName, Converter={x:Static aconv:ObjectConverters.IsNotNull}}" />
                <Button Grid.Column="2" Classes="danger-text" Content="Убрать" Command="{Binding RemoveAttachmentCommand}" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,12,0,0">
            <Button Grid.Column="0" Classes="soft" Click="OnPickImageClick" Margin="0,0,8,0" Padding="10">
                <mi:MaterialIcon Kind="ImageOutline" Width="18" Height="18" />
            </Button>
            <Button Grid.Column="1" Classes="soft" Click="OnPickFileClick" Margin="0,0,8,0" Padding="10">
                <mi:MaterialIcon Kind="FileOutline" Width="18" Height="18" />
            </Button>
            <TextBox Grid.Column="2" Name="Input" Text="{Binding Draft}" PlaceholderText="Спросите Scott..."
                      Background="{DynamicResource BgElevated}" Foreground="{DynamicResource TextPrimary}"
                      BorderBrush="{DynamicResource BorderColor}" CornerRadius="10" Padding="14,10">
                <!-- Enter отправляет: привычка есть у всех, а раньше работала
                     только кнопка. -->
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="3" Content="Отправить" Command="{Binding SendCommand}"
                    IsEnabled="{Binding !Sending}"
                    Background="{DynamicResource Accent}" Foreground="White"
                    Margin="10,0,0,0" Padding="18,10" CornerRadius="10" FontWeight="SemiBold" />
        </Grid>
    </Grid>
</UserControl>
