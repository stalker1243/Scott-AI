<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Avalonia.ViewModels"
             xmlns:models="using:ScottAI.Avalonia.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:DataType="vm:ActionsViewModel"
             x:Class="ScottAI.Avalonia.Views.ActionsView">

    <!-- Что Scott умеет.

         До сих пор узнать это было негде: четыре случайных примера на главной
         создавали впечатление, что он умеет ровно четыре вещи.

         Примеры нажимаются и уходят в чат: прочитать, как просить, мало — надо
         попробовать и увидеть ответ. -->

    <ScrollViewer>
        <StackPanel Margin="32,28" Spacing="20" MaxWidth="800" HorizontalAlignment="Left">

            <TextBlock Text="{Binding Summary}" FontSize="12"
                       Foreground="{DynamicResource TextMuted}"
                       IsVisible="{Binding Summary, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Foreground="{DynamicResource Danger}"
                       IsVisible="{Binding Error, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AbilityGroup">
                        <StackPanel Spacing="10" Margin="0,0,0,18">
                            <TextBlock Text="{Binding Group}" FontSize="11" FontWeight="SemiBold"
                                       LetterSpacing="1.1" Foreground="{DynamicResource TextMuted}" />

                            <ItemsControl ItemsSource="{Binding Items}" MinWidth="680">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Ability">
                                        <Border Background="{DynamicResource BgSurface}"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                                CornerRadius="12" Padding="16,14" Margin="0,0,0,8">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="3">
                                                        <TextBlock Text="{Binding Title}" FontSize="14"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimary}" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="12"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextMuted}" />
                                                    </StackPanel>

                                                    <!-- Недоступное не прячем: человек должен знать,
                                                         что Scott это умеет вообще, и почему не умеет
                                                         здесь. Спрятанное выглядело бы так, будто
                                                         такой возможности нет вовсе. -->
                                                    <Border Grid.Column="1" Background="{DynamicResource BgElevated}"
                                                            CornerRadius="7" Padding="9,4" VerticalAlignment="Top"
                                                            IsVisible="{Binding Unavailable}">
                                                        <TextBlock Text="недоступно" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="#F59E0B" />
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{Binding Reason}" FontSize="12" TextWrapping="Wrap"
                                                           Foreground="#F59E0B"
                                                           IsVisible="{Binding Unavailable}" />

                                                <!-- Примеры фраз. Нажимаются: Scott понимает «сделай
                                                     громче», но не «увеличь звук на 20 процентов», и
                                                     узнать об этом иначе неоткуда. -->
                                                <ItemsControl ItemsSource="{Binding Examples}"
                                                              IsVisible="{Binding Ready}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Button Classes="soft" Margin="0,0,8,0" Padding="12,7"
                                                                    FontSize="12"
                                                                    Command="{Binding $parent[UserControl].((vm:ActionsViewModel)DataContext).TryCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                                    <mi:MaterialIcon Kind="PlayOutline" Width="12" Height="12"
                                                                                     VerticalAlignment="Center"
                                                                                     Foreground="{DynamicResource Accent}" />
                                                                    <TextBlock Text="{Binding}" />
                                                                </StackPanel>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMuted}"
                       Text="Нажатие на пример отправляет фразу в чат — так же, как если бы вы сказали её голосом." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
