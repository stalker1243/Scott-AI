<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Avalonia.ViewModels"
             xmlns:models="using:ScottAI.Avalonia.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:DataType="vm:SystemViewModel"
             x:Class="ScottAI.Avalonia.Views.SystemView">
    <Grid Margin="32" RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Процессы" FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Обновить" Command="{Binding RefreshCommand}"
                    Background="{DynamicResource BgElevated}" Foreground="{DynamicResource TextPrimary}"
                    CornerRadius="8" Padding="14,8" />
        </Grid>

        <Border Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource Danger}" Opacity="0.15"
                CornerRadius="8" Padding="12,8" IsVisible="{Binding Error, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Processes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ProcessInfo">
                            <Grid ColumnDefinitions="*,90,90,90" Margin="16,10" >
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Grid.Column="1" Text="{Binding Pid}" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                                <Button Grid.Column="3" Content="Завершить" HorizontalAlignment="Right"
                                        Command="{Binding $parent[ItemsControl].((vm:SystemViewModel)DataContext).KillCommand}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" Foreground="{DynamicResource Danger}" FontSize="11" Padding="8,4" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
