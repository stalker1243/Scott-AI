<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Avalonia.ViewModels"
             xmlns:views="using:ScottAI.Avalonia.Views"
             xmlns:models="using:ScottAI.Avalonia.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:DataType="vm:SystemViewModel"
             x:Class="ScottAI.Avalonia.Views.SystemView">

    <!-- Состояние машины.

         Голограмма переехала сюда с главной страницы: там она отвечала на
         вопрос, которого при запуске помощника никто не задаёт, а здесь —
         рядом с числами нагрузки и списком процессов — она и есть предмет
         разговора. Показывает она то же самое, но иначе: по фигуре видно
         состояние целиком, одним взглядом, без чтения четырёх чисел.

         Поэтому и то, и другое: карточки отвечают «сколько именно», фигура —
         «всё ли в порядке». -->

    <ScrollViewer>
        <Grid Margin="32,28" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,*">

            <!-- ==================== Нагрузка ==================== -->

            <ItemsControl Grid.Row="0" Grid.Column="0" Margin="0,0,24,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <Border Classes="metric">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ПРОЦЕССОР" Classes="metriclabel" />
                        <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:0}%}" Classes="metricvalue" />
                        <ProgressBar Value="{Binding CpuPercent}" Minimum="0" Maximum="100" Height="4" />
                        <TextBlock Text="{Binding ProcessCount, StringFormat={}{0} процессов}"
                                   Classes="metrichint" />
                    </StackPanel>
                </Border>

                <Border Classes="metric">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ПАМЯТЬ" Classes="metriclabel" />
                        <TextBlock Text="{Binding RamPercent, StringFormat={}{0:0}%}" Classes="metricvalue" />
                        <ProgressBar Value="{Binding RamPercent}" Minimum="0" Maximum="100" Height="4" />
                        <TextBlock Text="занято сейчас" Classes="metrichint" />
                    </StackPanel>
                </Border>

                <Border Classes="metric">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ВИДЕОКАРТА" Classes="metriclabel" />
                        <TextBlock Text="{Binding GpuPercent, StringFormat={}{0:0}%}" Classes="metricvalue" />
                        <ProgressBar Value="{Binding GpuPercent}" Minimum="0" Maximum="100" Height="4" />
                        <!-- Ноль здесь означает и «свободна», и «её нет» —
                             различить это по одному числу нельзя, и обещать
                             большего не стоит. -->
                        <TextBlock Text="загрузка" Classes="metrichint" />
                    </StackPanel>
                </Border>
            </ItemsControl>

            <!-- Диск отдельной строкой: нагрузка и заполненность — разные
                 величины, и путать их нельзя. Именно на этом здесь уже
                 обжигались: вместо занятости диска работой показывалось, сколько
                 на нём места, и восемьдесят процентов выглядели как авария. -->
            <Border Grid.Row="1" Grid.Column="0" Classes="metric" Margin="0,12,24,0">
                <Grid ColumnDefinitions="*,*">
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="ДИСК — НАГРУЗКА" Classes="metriclabel" />
                        <TextBlock Text="{Binding DiskPercent, StringFormat={}{0:0}%}" Classes="metricvalue" />
                        <ProgressBar Value="{Binding DiskPercent}" Minimum="0" Maximum="100" Height="4"
                                     Margin="0,0,16,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="ДИСК — ЗАНЯТО МЕСТА" Classes="metriclabel" />
                        <TextBlock Text="{Binding DiskUsagePercent, StringFormat={}{0:0}%}" Classes="metricvalue" />
                        <ProgressBar Value="{Binding DiskUsagePercent}" Minimum="0" Maximum="100" Height="4" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== Голограмма ==================== -->

            <!-- Во всю высоту страницы, а не только над списком: иначе строки
                 с карточками растягивались под фигуру, и между ними и списком
                 процессов зияла пустота в половину экрана. -->
            <views:HologramView Grid.Row="0" Grid.RowSpan="3" Grid.Column="1"
                                VerticalAlignment="Top" Margin="8,0,0,0" />

            <!-- ==================== Процессы ==================== -->

            <Grid Grid.Row="2" Grid.Column="0" Margin="0,22,24,0"
                  RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Процессы" FontSize="17" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Command="{Binding RefreshCommand}" Classes="soft" Padding="14,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <mi:MaterialIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="Обновить" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource Danger}" Opacity="0.15"
                        CornerRadius="8" Padding="12,8"
                        IsVisible="{Binding Error, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
                </Border>

                <Border Grid.Row="2" Margin="0,12,0,0" MinHeight="220"
                        Background="{DynamicResource BgSurface}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12">
                    <ScrollViewer Padding="0,0,14,0">
                        <ItemsControl ItemsSource="{Binding Processes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ProcessInfo">
                                    <Grid ColumnDefinitions="*,90,90,100" Margin="16,10">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Pid}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2" Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" />
                                        <Button Grid.Column="3" Content="Завершить" HorizontalAlignment="Right"
                                                Command="{Binding $parent[ItemsControl].((vm:SystemViewModel)DataContext).KillCommand}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" Foreground="{DynamicResource Danger}"
                                                FontSize="11" Padding="8,4" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
