<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Avalonia.ViewModels"
             xmlns:models="using:ScottAI.Avalonia.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:myconv="using:ScottAI.Avalonia.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:DataType="vm:TemplatesViewModel"
             x:Class="ScottAI.Avalonia.Views.TemplatesView">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Готовые сценарии: одна кнопка запускает набор команд и создаёт связанные IFTTT-правила."
                       Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="Новый шаблон" Command="{Binding ToggleFormCommand}" Classes="soft" />
        </Grid>

        <Border Grid.Row="1" Margin="0,10,0,0" Background="{DynamicResource Danger}" Opacity="0.15"
                CornerRadius="8" Padding="12,8" IsVisible="{Binding Error, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Danger}" TextWrapping="Wrap" />
        </Border>
        <Border Grid.Row="2" Margin="0,10,0,0" Background="{DynamicResource Success}" Opacity="0.15"
                CornerRadius="8" Padding="12,8" IsVisible="{Binding Status, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource Success}" TextWrapping="Wrap" />
        </Border>

        <Border Grid.Row="3" Margin="0,14,0,0" Background="{DynamicResource BgSurface}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="18"
                IsVisible="{Binding ShowForm}">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,*">
                    <TextBox Grid.Column="0" Text="{Binding NewName}" PlaceholderText="Название" Margin="0,0,6,0" />
                    <TextBox Grid.Column="1" Text="{Binding NewCategory}" PlaceholderText="Категория" Margin="6,0,0,0" />
                </Grid>
                <TextBox Text="{Binding NewDescription}" PlaceholderText="Описание" />
                <TextBox Text="{Binding NewCommandsText}" PlaceholderText="Команды (по одной на строку)" AcceptsReturn="True" Height="80" />
                <Button Content="Сохранить" Command="{Binding CreateCommand}" HorizontalAlignment="Right" Classes="accent" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="4" Margin="0,14,0,0">
            <Panel>
                <ItemsControl Name="TemplatesList" ItemsSource="{Binding Templates}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ScottTemplate">
                            <Border Classes="card" Margin="0,0,14,14" Width="280" Background="{DynamicResource BgSurface}"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel Spacing="6">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding Icon}" FontSize="18" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextMuted}" FontSize="11" />
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                                        <Button Grid.Column="0" Content="Применить" Classes="accent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((vm:TemplatesViewModel)DataContext).ApplyCommand}"
                                                CommandParameter="{Binding}" Margin="0,0,8,0" />
                                        <Button Grid.Column="1" Content="Удалить" Classes="danger-text"
                                                Command="{Binding $parent[ItemsControl].((vm:TemplatesViewModel)DataContext).DeleteCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel IsVisible="{Binding Templates.Count, Converter={x:Static myconv:IsZeroConverter.Instance}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Margin="0,50">
                    <mi:MaterialIcon Kind="FileDocumentOutline" Width="38" Height="38" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Пока нет ни одного шаблона" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                    <TextBlock Text="Нажмите «Новый шаблон», чтобы создать первый." FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" />
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
