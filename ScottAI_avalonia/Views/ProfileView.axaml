<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Avalonia.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:myconv="using:ScottAI.Avalonia.Converters"
             xmlns:models="using:ScottAI.Avalonia.Models"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:DataType="vm:ProfileViewModel"
             x:Class="ScottAI.Avalonia.Views.ProfileView">
    <!-- Прокрутка обязательна: на невысоком окне нижняя часть страницы —
         имя, «о себе» и кнопка «Сохранить» — оказывалась за краем и была
         недоступна вовсе. -->
    <ScrollViewer>
    <StackPanel Margin="40" Spacing="24" MaxWidth="560">
        <StackPanel Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
            <!-- Итоговый вид: ровно так аватар выглядит в интерфейсе -->
            <Border Width="88" Height="88" CornerRadius="44" ClipToBounds="True" Background="{DynamicResource Accent}">
                <Grid>
                    <Image Source="{Binding AvatarImage}" Stretch="UniformToFill"
                           IsVisible="{Binding HasAvatar}">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding AvatarZoom}" ScaleY="{Binding AvatarZoom}" />
                                <!-- Сдвиг пересчитан из большой рамки (220) в маленькую (88):
                                     кадр подбирается на крупном превью, а показывается здесь. -->
                                <TranslateTransform X="{Binding AvatarOffsetX, Converter={x:Static myconv:AvatarPreviewScaleConverter.Instance}}"
                                                    Y="{Binding AvatarOffsetY, Converter={x:Static myconv:AvatarPreviewScaleConverter.Instance}}" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <TextBlock Text="👤" FontSize="34" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding !HasAvatar}" />
                </Grid>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="Локальный профиль Scott AI" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Изменить фото" Classes="soft" Click="OnPickAvatarClick" />
                    <Button Content="Удалить" Classes="danger-text" Command="{Binding RemoveAvatarCommand}"
                            IsVisible="{Binding HasAvatar}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Подбор кадра. Виден только когда есть что кадрировать. -->
        <StackPanel Spacing="10" IsVisible="{Binding HasAvatar}">
            <TextBlock Text="Положение фото" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
            <TextBlock Text="Перетащите снимок мышью, чтобы выбрать видимую часть. Приближение — ползунком или колесом с зажатым Ctrl."
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />

            <Border Width="220" Height="220" CornerRadius="110" ClipToBounds="True"
                    HorizontalAlignment="Left" Cursor="SizeAll"
                    Background="{DynamicResource BgElevated}"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="2"
                    PointerPressed="OnCropPressed" PointerMoved="OnCropMoved"
                    PointerReleased="OnCropReleased" PointerWheelChanged="OnCropWheel">
                <Image Source="{Binding AvatarImage}" Stretch="UniformToFill">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="{Binding AvatarZoom}" ScaleY="{Binding AvatarZoom}" />
                            <TranslateTransform X="{Binding AvatarOffsetX}" Y="{Binding AvatarOffsetY}" />
                        </TransformGroup>
                    </Image.RenderTransform>
                </Image>
            </Border>

            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="Приближение" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextMuted}" />
                <Slider Grid.Column="1" Minimum="1" Maximum="4" Value="{Binding AvatarZoom}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding AvatarZoom, StringFormat={}{0:0.0}×}"
                           VerticalAlignment="Center" Width="40" FontSize="12"
                           Foreground="{DynamicResource TextPrimary}" />
                <Button Grid.Column="3" Content="Сбросить" Command="{Binding ResetCropCommand}" Classes="soft" />
            </Grid>
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="Имя" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
            <TextBox Text="{Binding Name}" PlaceholderText="Как к вам обращаться?" />
        </StackPanel>

        <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="О себе" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" />
                <!-- Счётчик стоит здесь не для порядка: рассказ уходит в каждый
                     запрос к модели и там обрезается. Лучше увидеть предел
                     заранее, чем недосчитаться половины уже после сохранения. -->
                <TextBlock Grid.Column="1" Text="{Binding AboutCounter}" FontSize="11"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
            </Grid>
            <TextBox Text="{Binding Bio}" AcceptsReturn="True" Height="90"
                     PlaceholderText="Чем занимаетесь, что вам важно — Scott учтёт это в ответах" />
        </StackPanel>

        <!-- ==================== Характер ====================
             Раньше в профиле Scott лежал ключ personality, и не читал его
             никто: как бы он ни назывался, Scott отвечал одинаково. Теперь
             выбранное отсюда уходит в указание модели при каждом ответе. -->
        <StackPanel Spacing="8">
            <TextBlock Text="Характер" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
            <TextBlock Text="Каким тоном Scott будет отвечать. На то, что он умеет, это не влияет."
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />

            <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:PersonalityStyle">
                        <StackPanel Spacing="2" Margin="0,4">
                            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding Hint}" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- ==================== Интересы ====================
             Уходят в разговор вместе с рассказом о себе: Scott подбирает по ним
             примеры и объяснения. -->
        <StackPanel Spacing="8">
            <TextBlock Text="Интересы" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
            <TextBlock Text="Scott будет опираться на них в примерах и объяснениях."
                       FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />

            <ItemsControl ItemsSource="{Binding Interests}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Border Background="{DynamicResource BgElevated}" CornerRadius="14"
                                Padding="12,6" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}" FontSize="12" />
                                <Button Padding="2" Background="Transparent" BorderThickness="0"
                                        Command="{Binding $parent[ItemsControl].((vm:ProfileViewModel)DataContext).RemoveInterestCommand}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="Убрать интерес">
                                    <mi:MaterialIcon Kind="Close" Width="12" Height="12"
                                                     Foreground="{DynamicResource TextMuted}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding NewInterest}"
                         PlaceholderText="Например: музыка, астрономия, C#">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AddInterestCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Content="Добавить" Command="{Binding AddInterestCommand}"
                        Classes="soft" Margin="8,0,0,0" />
            </Grid>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" Classes="accent" />
            <TextBlock Text="Сохранено" Foreground="{DynamicResource Success}" VerticalAlignment="Center" FontWeight="SemiBold"
                       IsVisible="{Binding SavedRecently}" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
