<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Avalonia.ViewModels"
             xmlns:models="using:ScottAI.Avalonia.Models"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:DataType="vm:DiagnosticsViewModel"
             x:Class="ScottAI.Avalonia.Views.DiagnosticsView">

    <!-- Диагностика.

         Раздел для одного случая: «у меня не работает». Раньше на этот вопрос
         отвечали логи — человеку предлагалось прочесть чужой технический текст
         и самому догадаться, что в нём не так.

         Три состояния, а не два: жёлтое — это «работает, но хуже, чем могло
         бы». Отсутствие видеокарты не поломка, и, покрасив её красным, мы
         научили бы человека не обращать внимания на красное вовсе. -->

    <ScrollViewer>
        <StackPanel Margin="32,28" Spacing="18" MaxWidth="720" HorizontalAlignment="Left">

            <!-- ==================== Итог ==================== -->

            <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="12" Padding="18,16">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" VerticalAlignment="Center"
                            Background="{DynamicResource BgElevated}">
                        <Panel>
                            <mi:MaterialIcon Kind="CheckCircleOutline" Width="22" Height="22"
                                             Foreground="{DynamicResource Success}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             IsVisible="{Binding AllGood}" />
                            <mi:MaterialIcon Kind="AlertCircleOutline" Width="22" Height="22"
                                             Foreground="{DynamicResource Danger}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             IsVisible="{Binding HasFailures}" />
                        </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Danger}"
                                   IsVisible="{Binding Error, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                    </StackPanel>

                    <Button Grid.Column="2" Command="{Binding RefreshCommand}" IsEnabled="{Binding !Loading}"
                            Classes="soft" Padding="13,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <mi:MaterialIcon Kind="Refresh" Width="14" Height="14" VerticalAlignment="Center" />
                            <TextBlock Text="Проверить снова" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ==================== Проверки ==================== -->

            <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="12" Padding="4">
                <ItemsControl ItemsSource="{Binding Checks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:HealthCheck">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="14,12" ColumnSpacing="12">
                                <!-- Кружок состояния. Цвет говорит главное, подпись
                                     справа — остальное: одним цветом не объяснить,
                                     почему именно «не работает». -->
                                <Panel Grid.Column="0" VerticalAlignment="Center">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Success}"
                                             IsVisible="{Binding IsOk}" />
                                    <Ellipse Width="9" Height="9" Fill="#F59E0B"
                                             IsVisible="{Binding IsWarn}" />
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Danger}"
                                             IsVisible="{Binding IsFail}" />
                                </Panel>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding Detail}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>

                                <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Text="работает"
                                           Foreground="{DynamicResource Success}" IsVisible="{Binding IsOk}" />
                                <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Text="с оговоркой"
                                           Foreground="#F59E0B" IsVisible="{Binding IsWarn}" />
                                <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Text="не работает"
                                           Foreground="{DynamicResource Danger}" IsVisible="{Binding IsFail}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- ==================== Отчёт ====================
                 Главный способ рассказать о поломке: вместо «у меня не
                 работает» — восемь строк, по которым видно, что именно. Ключи
                 из отчёта вырезаны на стороне backend. -->

            <StackPanel Spacing="8">
                <Button Click="OnCopyReportClick" Classes="soft" Padding="16,10" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <mi:MaterialIcon Kind="ContentCopy" Width="15" Height="15" VerticalAlignment="Center" />
                        <TextBlock Text="Скопировать отчёт" />
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding Copied}" FontSize="12" Foreground="{DynamicResource Success}"
                           IsVisible="{Binding Copied, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                <TextBlock Text="В отчёт попадает то же, что на экране. Ключи доступа в него не включаются."
                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
