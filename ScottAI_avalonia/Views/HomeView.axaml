<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Avalonia.ViewModels"
             xmlns:views="using:ScottAI.Avalonia.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:DataType="vm:HomeViewModel"
             x:Class="ScottAI.Avalonia.Views.HomeView">

    <!-- Главная страница.

         Вся она — про один вопрос: что делать дальше. Поэтому в середине стоит
         поле ввода, а вокруг него ровно столько, сколько нужно, чтобы начать
         разговор: имя, строка о том, что это такое, и четыре примера команд.

         Примеры выбираются случайно при каждом запуске и нажимаются: раньше это
         был список того, что Scott умеет, но сделать с ним было нечего — человек
         читал «Закрой дискорд» и шёл печатать то же самое руками.

         Голограмма отсюда переехала в раздел «Система». Там ей и место: она
         показывает загрузку процессора, памяти и диска, то есть отвечает на
         вопрос, которого на первом экране никто не задаёт. -->

    <ScrollViewer>
        <StackPanel Spacing="0" MaxWidth="640" VerticalAlignment="Center"
                    HorizontalAlignment="Center" Margin="32,40">

            <!-- ==================== Имя ==================== -->

            <Border Name="Logo" Classes="logo" Width="76" Height="76" CornerRadius="22" ClipToBounds="True"
                    HorizontalAlignment="Center">
                <Image Source="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Logo}"
                       Width="76" Height="76" Stretch="UniformToFill" />
            </Border>

            <TextBlock Name="Title" Text="ScottAI" FontSize="28" FontWeight="Bold" Margin="0,18,0,0"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />

            <TextBlock Text="Ваш помощник. Ваш компьютер." FontSize="14" Margin="0,6,0,0"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />

            <!-- ==================== Поле ввода ==================== -->
            <!--
                 Спросить можно прямо отсюда. Раньше на первом экране места, куда
                 написать, не было вовсе: сначала приходилось догадаться зайти в
                 чат.
            -->
            <Grid Name="AskBlock" ColumnDefinitions="*,Auto" Margin="0,28,0,0">
                <TextBox Grid.Column="0" Name="Ask" Text="{Binding Draft}"
                         PlaceholderText="Напишите что-нибудь…"
                         Padding="16,13" CornerRadius="12" FontSize="14">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding AskCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>

                <Button Grid.Column="1" Command="{Binding AskCommand}" Classes="accent"
                        Margin="10,0,0,0" Padding="14" CornerRadius="12"
                        AutomationProperties.Name="Спросить">
                    <mi:MaterialIcon Kind="ArrowRight" Width="20" Height="20" />
                </Button>
            </Grid>

            <!-- ==================== Примеры команд ==================== -->

            <ItemsControl Name="ExamplesBlock" ItemsSource="{Binding Examples}" Margin="0,16,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <!-- В две колонки: четыре строки подряд читаются как
                             список дел, а сетка — как набор кнопок, чем они и
                             являются. -->
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HomeExample">
                        <Button Classes="tile"
                                Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).RunExampleCommand}"
                                CommandParameter="{Binding}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Margin="4" Padding="14,12">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <mi:MaterialIcon Kind="{Binding Icon}" Width="17" Height="17"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Accent}" />
                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ==================== Слух ==================== -->
            <!--
                 Состояние микрофона — единственное, что стоит показывать на
                 первом экране без спроса: Scott слушает комнату постоянно, и
                 человек вправе видеть, так ли это сейчас.
            -->
            <Grid Name="ListenBlock" ColumnDefinitions="Auto,*" Margin="4,22,4,0">
                <Button Grid.Column="0" Content="{Binding ListenButtonText}"
                        Command="{Binding ToggleListeningCommand}"
                        IsEnabled="{Binding MicAvailable}" Classes="soft" Padding="18,10" />

                <StackPanel Grid.Column="1" Spacing="3" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ListenHint}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}" />
                    <TextBlock FontSize="12" TextWrapping="Wrap" MaxLines="1"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextSecondary}"
                               IsVisible="{Binding LastHeard, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
                        <Run Text="Последнее услышанное:" />
                        <Run Text="{Binding LastHeard}" FontStyle="Italic" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
