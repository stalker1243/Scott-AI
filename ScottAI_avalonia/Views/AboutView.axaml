<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Avalonia.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:DataType="vm:AboutViewModel"
             x:Class="ScottAI.Avalonia.Views.AboutView">

    <!-- О программе.

         Раздел на первый взгляд необязательный, но версия нужна ровно в тот
         момент, когда что-то не работает: с неё начинается любой разговор о
         неполадке. Раньше узнать её было негде — она появлялась в карточке
         обновления, только когда выходила новая. -->

    <ScrollViewer>
        <StackPanel MaxWidth="520" Spacing="0" Margin="32,36" HorizontalAlignment="Center">

            <Border Classes="logo" Width="84" Height="84" CornerRadius="24" ClipToBounds="True"
                    HorizontalAlignment="Center">
                <Image Source="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Logo}"
                       Width="84" Height="84" Stretch="UniformToFill" />
            </Border>

            <TextBlock Text="ScottAI" FontSize="26" FontWeight="Bold" Margin="0,16,0,0"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />

            <TextBlock Text="Ваш помощник. Ваш компьютер." FontSize="13" Margin="0,6,0,0"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}" />

            <!-- ==================== Сведения ==================== -->

            <Border Background="{DynamicResource BgSurface}" BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,26,0,0">
                <StackPanel>
                    <Grid Classes="aboutrow" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Версия" Classes="aboutlabel" />
                        <TextBlock Grid.Column="1" Text="{Binding Version}" Classes="aboutvalue" />
                    </Grid>

                    <Grid Classes="aboutrow" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Разработчик" Classes="aboutlabel" />
                        <TextBlock Grid.Column="1" Text="{Binding Developer}" Classes="aboutvalue" />
                    </Grid>

                    <Grid Classes="aboutrow" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Платформа" Classes="aboutlabel" />
                        <TextBlock Grid.Column="1" Text="{Binding Platform}" Classes="aboutvalue" />
                    </Grid>

                    <Grid Classes="aboutrow" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="Backend" Classes="aboutlabel" />
                        <TextBlock Grid.Column="1" Text="{Binding BackendAddress}" Classes="aboutvalue" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ==================== Обновления ====================
                 Кнопка отвечает всегда — и когда обновление есть, и когда его
                 нет. Карточка наверху окна молчит намеренно, но нажатие руками
                 без ответа выглядит как сломанная кнопка. -->

            <StackPanel Spacing="10" Margin="0,22,0,0" HorizontalAlignment="Center">
                <Button Command="{Binding CheckUpdatesCommand}" IsEnabled="{Binding !Checking}"
                        Classes="soft" Padding="18,11" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <mi:MaterialIcon Kind="TrayArrowDown" Width="16" Height="16" VerticalAlignment="Center" />
                        <TextBlock Text="Проверить обновления" />
                    </StackPanel>
                </Button>

                <TextBlock Text="{Binding CheckStatus}" FontSize="12" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondary}"
                           IsVisible="{Binding CheckStatus, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                <Button Content="Что нового" Command="{Binding OpenReleaseCommand}"
                        Classes="accent" HorizontalAlignment="Center"
                        IsVisible="{Binding UpdateFound}" />
            </StackPanel>

            <TextBlock Text="© 2026 Phantom. Работает на вашем компьютере." FontSize="11"
                       Margin="0,30,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextMuted}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
