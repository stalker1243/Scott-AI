<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScottAI.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:ScottAI.Avalonia.Converters"
        xmlns:aconv="using:Avalonia.Data.Converters"
        xmlns:models="using:ScottAI.Avalonia.Models"
        xmlns:mi="using:Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="860"
        x:Class="ScottAI.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1400" Height="860"
        Background="{DynamicResource BgWindow}"
        FontFamily="{DynamicResource AppFontFamily}"
        Title="ScottAI (Avalonia)"
        Icon="/Assets/scott.ico">

    <Panel>
    <Grid ColumnDefinitions="96,*">

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebar}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <!-- Логотип. Подложки под ним нет намеренно: у самой иконки тёмный
                     фон со свечением по краю, и акцентный квадрат за прозрачными
                     углами выглядел бы рамкой. -->
                <Border Classes="logo" Width="52" Height="52" CornerRadius="14" Margin="0,22,0,24"
                        HorizontalAlignment="Center" DockPanel.Dock="Top" ClipToBounds="True">
                    <Image Source="{Binding Logo}" Width="52" Height="52" Stretch="UniformToFill" />
                </Border>

                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="8,0">
                    <Button Command="{Binding NavigateHomeCommand}" Classes="nav" AutomationProperties.Name="Главная"
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=home}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="Home" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Главная" HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateChatCommand}" Classes="nav" AutomationProperties.Name="Чат"
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=chat}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="ChatOutline" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Чат" HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateSystemCommand}" Classes="nav" AutomationProperties.Name="Система"
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=system}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="Cpu64Bit" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Система" HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateAutomationCommand}" Classes="nav" AutomationProperties.Name="Автомат."
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=automation}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="LightningBolt" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Автомат." HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateAnalyticsCommand}" Classes="nav" AutomationProperties.Name="Аналит."
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=analytics}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="ChartBar" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Аналит." HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateSettingsCommand}" Classes="nav" AutomationProperties.Name="Настр."
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=settings}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="CogOutline" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Настр." HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateProfileCommand}" Classes="nav" AutomationProperties.Name="Профиль"
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=profile}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="AccountCircleOutline" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Профиль" HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateLogsCommand}" Classes="nav" AutomationProperties.Name="Логи"
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=logs}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="TextBoxSearchOutline" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Логи" HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Ellipse DockPanel.Dock="Bottom" Width="10" Height="10" Margin="0,0,0,20" HorizontalAlignment="Center"
                         Classes="statusdot" Classes.pulse="{Binding BackendStatus, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=online}"
                         Fill="{Binding BackendStatus, Converter={x:Static conv:BackendStatusToBrushConverter.Instance}}">
                    <Ellipse.Transitions>
                        <Transitions>
                            <BrushTransition Property="Fill" Duration="0:0:0.35" />
                        </Transitions>
                    </Ellipse.Transitions>
                </Ellipse>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" RowDefinitions="Auto,72,*">
            <!-- Сообщение о новой версии. Показывается один раз при запуске и
                 закрывается крестиком: обновление не выпрашивается. Стоит над
                 шапкой намеренно — сдвигает страницу вниз, а не накрывает её,
                 поэтому ничего не загораживает. -->
            <Border Grid.Row="0" IsVisible="{Binding Update.Visible}" Classes="updatecard"
                    Margin="16,16,16,0" Padding="20,16" CornerRadius="14"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="{DynamicResource AccentColor}" />
                        <GradientStop Offset="1" Color="Transparent" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <!-- Иконка в круге: сообщение узнаётся раньше, чем прочитано. -->
                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                            Background="{DynamicResource Accent}" VerticalAlignment="Top">
                        <mi:MaterialIcon Kind="TrayArrowDown" Width="24" Height="24" Foreground="White"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Update.Headline}" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="7,2"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding Update.SizeText, Converter={x:Static aconv:StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Update.SizeText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}" />
                            </Border>
                            <TextBlock Text="{Binding Update.DateText}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}"
                                       IsVisible="{Binding Update.DateText, Converter={x:Static aconv:StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>

                        <TextBlock Text="{Binding Update.Notes}" FontSize="12" MaxLines="2"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondary}"
                                   IsVisible="{Binding Update.Notes, Converter={x:Static aconv:StringConverters.IsNotNullOrEmpty}}" />

                        <!-- Во время загрузки: полоса во всю ширину и счёт в мегабайтах.
                             Проценты сами по себе не отвечают на вопрос «сколько ждать». -->
                        <StackPanel Spacing="5" Margin="0,2,0,0" IsVisible="{Binding Update.Downloading}">
                            <ProgressBar Value="{Binding Update.Progress}" Minimum="0" Maximum="100" Height="5" />
                            <TextBlock Text="{Binding Update.Status}" FontSize="11"
                                       Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>

                        <Border IsVisible="{Binding Update.Error, Converter={x:Static aconv:ObjectConverters.IsNotNull}}"
                                Background="{DynamicResource BgElevated}" CornerRadius="8" Padding="10,7" Margin="0,2,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <mi:MaterialIcon Kind="AlertCircleOutline" Width="14" Height="14"
                                                  Foreground="{DynamicResource Danger}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Update.Error}" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Danger}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center" IsVisible="{Binding !Update.Downloading}">
                        <Button Classes="soft" Command="{Binding Update.OpenReleaseCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="TextBoxOutline" Width="14" Height="14" />
                                <TextBlock Text="Что нового" />
                            </StackPanel>
                        </Button>
                        <!-- Фон задан прямо здесь, а не классом: шаблон кнопки из
                             темы Fluent перекрывает Background из стиля класса, и
                             акцентная кнопка выходила блёклой. Тот же приём
                             используется на главной странице. -->
                        <Button Command="{Binding Update.InstallCommand}"
                                Background="{DynamicResource Accent}" Foreground="White"
                                CornerRadius="8" Padding="16,9" FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <mi:MaterialIcon Kind="Download" Width="15" Height="15" />
                                <TextBlock Text="Установить" />
                            </StackPanel>
                        </Button>
                        <Button Classes="soft" Padding="8" Command="{Binding Update.DismissCommand}"
                                ToolTip.Tip="Скрыть до следующего запуска">
                            <mi:MaterialIcon Kind="Close" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="{DynamicResource BgTopbar}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto" Margin="28,0">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ScottAI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding PageTitle}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Classes="statusdot"
                                 Classes.pulse="{Binding BackendStatus, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=online}"
                                 Fill="{Binding BackendStatus, Converter={x:Static conv:BackendStatusToBrushConverter.Instance}}" />
                        <TextBlock Text="{Binding BackendStatus}"
                                   FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" ClipToBounds="True">
                <!-- Фоновые декоративные пятна — только для Classic (Glass уже "живой" за счёт
                     настоящего блюра рабочего стола, Terminal Pro нарочно строгий/плоский). -->
                <Canvas IsHitTestVisible="False" IsVisible="{Binding IsClassicStyle}">
                    <Ellipse Canvas.Right="-160" Canvas.Top="-140" Width="420" Height="420"
                              Fill="{DynamicResource Accent}" Opacity="0.10">
                        <Ellipse.Effect>
                            <BlurEffect Radius="90" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Canvas.Left="-120" Canvas.Bottom="-180" Width="360" Height="360"
                              Fill="{DynamicResource Success}" Opacity="0.06">
                        <Ellipse.Effect>
                            <BlurEffect Radius="90" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <TransitioningContentControl Content="{Binding CurrentPage}">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.22" />
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </Grid>
        </Grid>
    </Grid>

    <!-- Мастер первого запуска. Занимает окно целиком, а не показывается
         рядом: пока не поставлены torch и модели речи, работать всё равно
         нечему, и пускать человека в интерфейс, где ничего не отвечает, —
         значит показывать ему сломанную программу. -->
    <Border IsVisible="{Binding FirstRun.Visible}" Background="{DynamicResource BgWindow}">
        <StackPanel Width="520" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="{Binding Logo}" Width="72" Height="72" HorizontalAlignment="Center" />

            <TextBlock Text="{Binding FirstRun.Title}" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />

            <TextBlock Text="{Binding FirstRun.Explanation}" TextWrapping="Wrap"
                       TextAlignment="Center" Foreground="{DynamicResource TextSecondary}" />

            <StackPanel Spacing="8" IsVisible="{Binding FirstRun.Error, Converter={x:Static aconv:ObjectConverters.IsNull}}">
                <ProgressBar Value="{Binding FirstRun.Progress}" Minimum="0" Maximum="100" Height="6" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding FirstRun.Status}" FontSize="12"
                               Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding FirstRun.Progress, StringFormat={}{0:0}%}"
                               FontSize="12" Foreground="{DynamicResource TextMuted}" />
                </Grid>
            </StackPanel>

            <Border IsVisible="{Binding FirstRun.Error, Converter={x:Static aconv:ObjectConverters.IsNotNull}}"
                    Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource Danger}"
                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                <StackPanel Spacing="10">
                    <TextBlock Text="Установка не удалась" FontWeight="SemiBold"
                               Foreground="{DynamicResource Danger}" />
                    <SelectableTextBlock Text="{Binding FirstRun.Error}" TextWrapping="Wrap"
                                         FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock Text="Чаще всего дело в оборвавшейся сети — уже скачанное не пропадёт, повтор продолжит с места остановки."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMuted}" />
                    <Button Content="Попробовать снова" Classes="accent" HorizontalAlignment="Left"
                            Command="{Binding FirstRun.RetryCommand}" IsVisible="{Binding FirstRun.CanRetry}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>

    <!-- Модальное подтверждение опасных действий (kill process, удаление команд/правил/
         макросов/шаблонов) — раньше эти действия срабатывали мгновенно без предупреждения. -->
    <Border IsVisible="{Binding DialogVisible}" Background="#B3000000">
        <Border Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" CornerRadius="14" Padding="26" Width="400"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <TextBlock Text="{Binding DialogTitle}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{Binding DialogMessage}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Content="Отмена" Classes="soft" Command="{Binding CancelDialogCommand}" />
                    <Button Content="{Binding DialogConfirmLabel}" Classes="accent" Classes.danger="{Binding DialogDanger}"
                            Command="{Binding ConfirmDialogCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

    <!-- Всплывающие уведомления об успехе/ошибке — правый нижний угол, поверх любой страницы. -->
    <ItemsControl Name="ToastHost" ItemsSource="{Binding Toasts}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" IsHitTestVisible="True">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:ToastMessage">
                <Border Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12" Width="340">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="18" OffsetX="0" OffsetY="4" />
                    </Border.Effect>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <mi:MaterialIcon Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top"
                                          Kind="{Binding Kind, Converter={x:Static conv:ToastKindToIconConverter.Instance}}"
                                          Foreground="{Binding Kind, Converter={x:Static conv:ToastKindToBrushConverter.Instance}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextPrimary}" FontSize="13" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="✕" Classes="danger-text" Padding="4" Margin="8,0,0,0"
                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DismissToastCommand}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </Panel>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransform" Value="scale(1.0)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="RenderTransform" Value="scale(1.05)" />
        </Style>
        <Style Selector="Button.nav:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="TextBlock.navlabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="mi|MaterialIcon.navicon">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav:pointerover mi|MaterialIcon.navicon">
            <Setter Property="RenderTransform" Value="scale(1.12) rotate(-4deg)" />
        </Style>
        <Style Selector="Button.nav.active mi|MaterialIcon.navicon">
            <Setter Property="RenderTransform" Value="scale(1.08)" />
        </Style>

        <!-- Общие "мягкие" кнопки — переиспользуются на всех страницах -->
        <Style Selector="Button.soft">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="RenderTransform" Value="scale(1.0)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.soft:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>
        <Style Selector="Button.soft:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button.soft.tabactive">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <!-- Сообщение о новой версии приезжает сверху, а не возникает рывком:
             оно появляется под курсором на уже открытом окне. -->
        <Style Selector="Border.updatecard">
            <Style.Animations>
                <Animation Duration="0:0:0.45" FillMode="Forward" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-22" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransform" Value="scale(1.0)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.accent:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>
        <Style Selector="Button.accent:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>

        <Style Selector="Button.danger-text">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.danger-text:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource Danger}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransform" Value="scale(1.0)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>
        <Style Selector="Button.danger:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>

        <!-- Переключатель вкладок/режимов (используется в Автоматизации и Настройках) -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tab.tabactive">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>

        <!-- Выбор иконки приложения: карточка с картинкой и подписью. Рамка
             заметная и в невыбранном состоянии — иначе на светлой иконке
             границу карточки не видно вовсе. -->
        <Style Selector="Button.iconpick">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
        </Style>

        <Style Selector="Button.iconpick.tabactive">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>

        <!-- Круглые свотчи цвета (акцент в Настройках) -->
        <Style Selector="Button.swatch">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="RenderTransform" Value="scale(1.0)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.swatch.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
        <Style Selector="Button.swatch:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.15)" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.swatch:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>

        <!-- Базовые стили полей ввода — по умолчанию FluentTheme рисует их в
             нейтральных системных тонах, которые не сочетаются с тёмной/светлой
             палитрой приложения. -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="ComboBox Popup Border">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        </Style>

        <!-- Карточка с лёгким "подъёмом" и акцентной подсветкой рамки при наведении —
             акцентный цвет становится заметен на большей площади интерфейса. -->
        <Style Selector="Border.card">
            <Setter Property="RenderTransform" Value="translateY(0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Border.card:pressed">
            <Setter Property="RenderTransform" Value="translateY(0px) scale(0.98)" />
        </Style>

        <!-- Лого в сайдбаре — тихое "дыхание", чтобы приложение ощущалось живым в простое.
             Только Opacity: Avalonia's Style.Animations (в отличие от Transitions) не имеет
             зарегистрированного аниматора для RenderTransform в этой версии. -->
        <Style Selector="Border.logo">
            <Style.Animations>
                <Animation Duration="0:0:2.6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.78" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Точка статуса backend — мягкий пульс, пока Scott online; для starting/offline остаётся статичной. -->
        <Style Selector="Ellipse.statusdot.pulse">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>
</Window>
