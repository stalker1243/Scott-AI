<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScottAI.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="using:ScottAI.Avalonia.Converters"
        xmlns:models="using:ScottAI.Avalonia.Models"
        xmlns:mi="using:Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="860"
        x:Class="ScottAI.Avalonia.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1400" Height="860"
        Background="{DynamicResource BgWindow}"
        FontFamily="{DynamicResource AppFontFamily}"
        Title="ScottAI (Avalonia)"
        Icon="/Assets/scott.ico">

    <Panel>
    <Grid ColumnDefinitions="96,*">

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource BgSidebar}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <Border Classes="logo" Width="52" Height="52" CornerRadius="14" Margin="0,22,0,24"
                        Background="{DynamicResource Accent}" HorizontalAlignment="Center" DockPanel.Dock="Top">
                    <TextBlock Text="S" FontSize="24" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="8,0">
                    <Button Command="{Binding NavigateHomeCommand}" Classes="nav"
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=home}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="Home" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Главная" HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateChatCommand}" Classes="nav"
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=chat}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="ChatOutline" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Чат" HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateSystemCommand}" Classes="nav"
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=system}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="Cpu64Bit" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Система" HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateAutomationCommand}" Classes="nav"
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=automation}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="LightningBolt" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Автомат." HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateAnalyticsCommand}" Classes="nav"
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=analytics}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="ChartBar" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Аналит." HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateSettingsCommand}" Classes="nav"
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=settings}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="CogOutline" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Настр." HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateProfileCommand}" Classes="nav"
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=profile}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="AccountCircleOutline" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Профиль" HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NavigateLogsCommand}" Classes="nav"
                            Classes.active="{Binding ActivePage, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=logs}">
                        <StackPanel Spacing="3">
                            <mi:MaterialIcon Kind="TextBoxSearchOutline" Width="21" Height="21" HorizontalAlignment="Center" Classes="navicon" />
                            <TextBlock Text="Логи" HorizontalAlignment="Center" Classes="navlabel" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Ellipse DockPanel.Dock="Bottom" Width="10" Height="10" Margin="0,0,0,20" HorizontalAlignment="Center"
                         Classes="statusdot" Classes.pulse="{Binding BackendStatus, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=online}"
                         Fill="{Binding BackendStatus, Converter={x:Static conv:BackendStatusToBrushConverter.Instance}}">
                    <Ellipse.Transitions>
                        <Transitions>
                            <BrushTransition Property="Fill" Duration="0:0:0.35" />
                        </Transitions>
                    </Ellipse.Transitions>
                </Ellipse>
            </DockPanel>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" RowDefinitions="72,*">
            <Border Grid.Row="0" Background="{DynamicResource BgTopbar}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto" Margin="28,0">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ScottAI" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding PageTitle}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Classes="statusdot"
                                 Classes.pulse="{Binding BackendStatus, Converter={x:Static conv:EqualsConverter.Instance}, ConverterParameter=online}"
                                 Fill="{Binding BackendStatus, Converter={x:Static conv:BackendStatusToBrushConverter.Instance}}" />
                        <TextBlock Text="{Binding BackendStatus}"
                                   FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" ClipToBounds="True">
                <!-- Фоновые декоративные пятна — только для Classic (Glass уже "живой" за счёт
                     настоящего блюра рабочего стола, Terminal Pro нарочно строгий/плоский). -->
                <Canvas IsHitTestVisible="False" IsVisible="{Binding IsClassicStyle}">
                    <Ellipse Canvas.Right="-160" Canvas.Top="-140" Width="420" Height="420"
                              Fill="{DynamicResource Accent}" Opacity="0.10">
                        <Ellipse.Effect>
                            <BlurEffect Radius="90" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <Ellipse Canvas.Left="-120" Canvas.Bottom="-180" Width="360" Height="360"
                              Fill="{DynamicResource Success}" Opacity="0.06">
                        <Ellipse.Effect>
                            <BlurEffect Radius="90" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>

                <TransitioningContentControl Content="{Binding CurrentPage}">
                    <TransitioningContentControl.PageTransition>
                        <CrossFade Duration="0:0:0.22" />
                    </TransitioningContentControl.PageTransition>
                </TransitioningContentControl>
            </Grid>
        </Grid>
    </Grid>

    <!-- Модальное подтверждение опасных действий (kill process, удаление команд/правил/
         макросов/шаблонов) — раньше эти действия срабатывали мгновенно без предупреждения. -->
    <Border IsVisible="{Binding DialogVisible}" Background="#B3000000">
        <Border Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1" CornerRadius="14" Padding="26" Width="400"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <TextBlock Text="{Binding DialogTitle}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                <TextBlock Text="{Binding DialogMessage}" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                    <Button Content="Отмена" Classes="soft" Command="{Binding CancelDialogCommand}" />
                    <Button Content="{Binding DialogConfirmLabel}" Classes="accent" Classes.danger="{Binding DialogDanger}"
                            Command="{Binding ConfirmDialogCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>

    <!-- Всплывающие уведомления об успехе/ошибке — правый нижний угол, поверх любой страницы. -->
    <ItemsControl Name="ToastHost" ItemsSource="{Binding Toasts}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" IsHitTestVisible="True">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:ToastMessage">
                <Border Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1" CornerRadius="10" Padding="14,12" Width="340">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="18" OffsetX="0" OffsetY="4" />
                    </Border.Effect>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <mi:MaterialIcon Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Top"
                                          Kind="{Binding Kind, Converter={x:Static conv:ToastKindToIconConverter.Instance}}"
                                          Foreground="{Binding Kind, Converter={x:Static conv:ToastKindToBrushConverter.Instance}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                    Foreground="{DynamicResource TextPrimary}" FontSize="13" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="✕" Classes="danger-text" Padding="4" Margin="8,0,0,0"
                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).DismissToastCommand}"
                                CommandParameter="{Binding}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </Panel>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,10" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransform" Value="scale(1.0)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav:pointerover">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="RenderTransform" Value="scale(1.05)" />
        </Style>
        <Style Selector="Button.nav:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="TextBlock.navlabel">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="mi|MaterialIcon.navicon">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.nav:pointerover mi|MaterialIcon.navicon">
            <Setter Property="RenderTransform" Value="scale(1.12) rotate(-4deg)" />
        </Style>
        <Style Selector="Button.nav.active mi|MaterialIcon.navicon">
            <Setter Property="RenderTransform" Value="scale(1.08)" />
        </Style>

        <!-- Общие "мягкие" кнопки — переиспользуются на всех страницах -->
        <Style Selector="Button.soft">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="RenderTransform" Value="scale(1.0)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.soft:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
        </Style>
        <Style Selector="Button.soft:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>
        <Style Selector="Button.soft.tabactive">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransform" Value="scale(1.0)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.accent:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>
        <Style Selector="Button.accent:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>

        <Style Selector="Button.danger-text">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.danger-text:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource Danger}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="RenderTransform" Value="scale(1.0)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.03)" />
            <Setter Property="Opacity" Value="0.92" />
        </Style>
        <Style Selector="Button.danger:pressed">
            <Setter Property="RenderTransform" Value="scale(0.96)" />
        </Style>

        <!-- Переключатель вкладок/режимов (используется в Автоматизации и Настройках) -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.tab.tabactive">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>

        <!-- Круглые свотчи цвета (акцент в Настройках) -->
        <Style Selector="Button.swatch">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="RenderTransform" Value="scale(1.0)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.swatch.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="3" />
        </Style>
        <Style Selector="Button.swatch:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.15)" />
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="Button.swatch:pressed">
            <Setter Property="RenderTransform" Value="scale(0.92)" />
        </Style>

        <!-- Базовые стили полей ввода — по умолчанию FluentTheme рисует их в
             нейтральных системных тонах, которые не сочетаются с тёмной/светлой
             палитрой приложения. -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,9" />
        </Style>
        <Style Selector="ComboBox /template/ Border#Background">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
        </Style>
        <Style Selector="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="ComboBox Popup Border">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        </Style>

        <!-- Карточка с лёгким "подъёмом" и акцентной подсветкой рамки при наведении —
             акцентный цвет становится заметен на большей площади интерфейса. -->
        <Style Selector="Border.card">
            <Setter Property="RenderTransform" Value="translateY(0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Border.card:pressed">
            <Setter Property="RenderTransform" Value="translateY(0px) scale(0.98)" />
        </Style>

        <!-- Лого в сайдбаре — тихое "дыхание", чтобы приложение ощущалось живым в простое.
             Только Opacity: Avalonia's Style.Animations (в отличие от Transitions) не имеет
             зарегистрированного аниматора для RenderTransform в этой версии. -->
        <Style Selector="Border.logo">
            <Style.Animations>
                <Animation Duration="0:0:2.6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.78" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1.0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Точка статуса backend — мягкий пульс, пока Scott online; для starting/offline остаётся статичной. -->
        <Style Selector="Ellipse.statusdot.pulse">
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.35" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>
</Window>
