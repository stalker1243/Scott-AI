# Scott AI — переменные окружения.
# Скопируйте этот файл в .env и подставьте свои значения. Файл .env в git не
# попадает (он в .gitignore), поэтому ключи остаются только на вашей машине.
#
# Обязательного здесь почти ничего нет: без единого ключа Scott запустится,
# будет слушать, отвечать голосом и управлять компьютером. Ключи добавляют
# ответы от LLM и открывают отдельные команды.

# ===== Backend =====
# Только этот компьютер. 0.0.0.0 открыл бы Scott всей локальной сети,
# а /command токена не требует — команды мог бы слать кто угодно.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_RELOAD=false

# ===== Синтез речи =====
# silero — локальный, работает офлайн на видеокарте, около 120 мс на фразу.
# edge — облачный Microsoft, около 1.9 с и требует интернет; на него синтез
# откатывается сам, если локальный не справился.
TTS_ENGINE=silero
# Голос. Для silero: aidar, eugene (муж.), baya, kseniya, xenia (жен.).
# Для edge: ru-RU-DmitryNeural и другие. Пусто — голос движка по умолчанию.
TTS_VOICE=
# Устройство для Silero: cuda / cpu. Пусто — автовыбор.
SILERO_DEVICE=
TTS_RATE=+15%
TTS_PITCH=-10Hz

# ===== Распознавание речи =====
WHISPER_MODEL=small
WHISPER_LANGUAGE=ru
# cuda / cpu. Пусто — автовыбор. На процессоре модель small распознаёт
# короткую фразу около 6.6 с, на видеокарте — доли секунды.
WHISPER_DEVICE=

# Прогрев моделей при старте. Без него первая голосовая команда после запуска
# стоит около семи секунд вместо одной. Выключается значением 0, если
# видеокарта нужна под другое.
WARMUP_MODELS=1

# ===== Ответы от LLM =====
# Достаточно одного из трёх. Без них Scott отвечает только локальными
# правилами и базой знаний — команды к компьютеру работают в любом случае.
# Groq: https://console.groq.com (быстрый, есть бесплатный тариф)
GROQ_API_KEY=
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ===== Безопасность =====
# Токен для опасных операций: /kill-process, /extended/powershell, выключение и
# перезагрузка, удаление файлов. Защита работает fail-closed — пока значение
# пустое, эти эндпоинты закрыты для всех. Придумайте длинную случайную строку.
EXECUTE_TOKEN=

# ===== Веб-интеграции (необязательно) =====
# Оба ключа только улучшают команды, но не требуются для их работы.
#
# YouTube: с ключом «Скотт, найди на ютубе ...» открывает сразу нужный ролик,
# без ключа — страницу результатов поиска. Бесплатно, карта не нужна:
# console.cloud.google.com → новый проект → включить «YouTube Data API v3» →
# Учётные данные → Ключ API. Квота 10 000 единиц в сутки, поиск стоит 100.
YOUTUBE_API_KEY=
# GitHub: поднимает лимит поиска с 10 до 30 запросов в минуту. Для одной
# машины хватает и десяти. Создать (без единого scope, только публичный поиск):
# https://github.com/settings/tokens
GITHUB_TOKEN=

# ===== Прочее =====
LOG_LEVEL=info
LOG_FILE=jarvis.log
DEBUG=false
MEMORY_FILE=backend/jarvis_memory.json
