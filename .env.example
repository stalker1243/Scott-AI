# Scott AI - Переменные окружения
# Скопируйте этот файл в .env и установите ваши значения

# OpenAI API ключ для ИИ-ассистента (обязателен для ChatGPT функций)
# Получить можно на https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx...

# Опциональные настройки
# OPENAI_API_ORG=org-xxx (если используете организацию)
