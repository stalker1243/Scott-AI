+# Preserve the approved Transformers 4 SDPA encoder's full causal context.
+# Transformers 5 switched Mimi to a sliding-window mask, changing reference codes.
+from transformers.models.mimi.modeling_mimi import MimiTransformerModel
+
+
+class _ScottMimiTransformerModel(MimiTransformerModel):
+    def forward(self, hidden_states=None, attention_mask=None, position_ids=None,
+                past_key_values=None, use_cache=None, output_attentions=None,
+                output_hidden_states=None, return_dict=None, **kwargs):
+        first = past_key_values is None or past_key_values.get_seq_length() == 0
+        if first and (attention_mask is None or attention_mask.ndim == 2):
+            length = hidden_states.shape[1]
+            minimum = torch.finfo(hidden_states.dtype).min
+            causal = torch.full((length, length), minimum, device=hidden_states.device, dtype=hidden_states.dtype)
+            causal = torch.triu(causal, diagonal=1)[None, None].expand(hidden_states.shape[0], 1, -1, -1)
+            if attention_mask is not None:
+                causal = causal.masked_fill(attention_mask[:, None, None, :] == 0, minimum)
+            attention_mask = causal
+        return super().forward(hidden_states=hidden_states, attention_mask=attention_mask,
+            position_ids=position_ids, past_key_values=past_key_values, use_cache=use_cache,
+            output_attentions=output_attentions, output_hidden_states=output_hidden_states,
+            return_dict=return_dict, **kwargs)
+
+
