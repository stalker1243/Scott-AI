+        # Modified by ScottAI: Transformers 5 materializes nonpersistent buffers
+        # from meta tensors. Qwen's old initializer does not rebuild its RoPE
+        # buffers; restore the same CPU-computed frequencies as Transformers 4.
+        with torch.no_grad():
