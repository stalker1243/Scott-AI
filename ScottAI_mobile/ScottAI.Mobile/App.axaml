<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ScottAI.Mobile"
             x:Class="ScottAI.Mobile.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Цвета заданы для обеих тем сразу. Акцент и мягкая подложка
             перезаписываются на ходу из «Внешнего вида» — они здесь только
             как значения по умолчанию до первого выбора. -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgWindow">#10161F</SolidColorBrush>
                    <SolidColorBrush x:Key="BgSurface">#1A2332</SolidColorBrush>
                    <SolidColorBrush x:Key="BgElevated">#212C3D</SolidColorBrush>
                    <SolidColorBrush x:Key="BgBar">#0D1420</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPrimary">#F3F4F6</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondary">#9CA3AF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMuted">#6B7280</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderColor">#2A3547</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgWindow">#F5F7FA</SolidColorBrush>
                    <SolidColorBrush x:Key="BgSurface">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BgElevated">#EEF2F7</SolidColorBrush>
                    <SolidColorBrush x:Key="BgBar">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPrimary">#111827</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondary">#4B5563</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMuted">#9CA3AF</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderColor">#DDE3EC</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="Accent">#3B82F6</SolidColorBrush>
            <Color x:Key="AccentColor">#3B82F6</Color>
            <SolidColorBrush x:Key="AccentSoft" Color="#3B82F6" Opacity="0.18" />
            <SolidColorBrush x:Key="Warning">#F59E0B</SolidColorBrush>
            <SolidColorBrush x:Key="Danger">#EF4444</SolidColorBrush>
            <SolidColorBrush x:Key="Success">#22C55E</SolidColorBrush>
            <x:Double x:Key="ChatFontSize">15</x:Double>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Пальцем, а не мышью: всё нажимаемое не меньше 44 точек в высоту.
             Это не про красоту — по меньшей кнопке промахиваются на ходу.

             Фон задаётся и самой кнопке, и её содержимому внутри шаблона.
             Так приходится делать потому, что Fluent красит не кнопку, а
             ContentPresenter внутри неё: одного Background на кнопке мало —
             тема перекрывает его, и кнопка остаётся серой, как ни задавай
             цвет снаружи. Проверено на «Привязать»: акцентной она стала
             только после того, как цвет дошёл до содержимого. -->
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>

        <Style Selector="Button.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Нажатие должно быть видно. На телефоне это единственный отклик:
             курсора нет, и без него непонятно, попал палец или нет. -->
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.75" />
        </Style>

        <Style Selector="Button.quiet /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.quiet">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="14,10" />
        </Style>

        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
    </Application.Styles>
</Application>
