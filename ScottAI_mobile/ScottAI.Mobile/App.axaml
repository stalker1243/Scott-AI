<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ScottAI.Mobile"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="ScottAI.Mobile.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Тёмная тема — основная. Не чёрный, а глубокий синий: на
                     телефоне чистый чёрный выглядит провалом, а не фоном, и на
                     нём особенно заметна любая неровность подсветки. -->
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="BgWindow">#0B1018</SolidColorBrush>
                    <SolidColorBrush x:Key="BgSurface">#141C28</SolidColorBrush>
                    <SolidColorBrush x:Key="BgElevated">#1C2736</SolidColorBrush>
                    <SolidColorBrush x:Key="BgBar">#0E141E</SolidColorBrush>
                    <SolidColorBrush x:Key="BgInput">#1A2331</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPrimary">#F2F5F9</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondary">#9AA7B8</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMuted">#64748B</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderColor">#243044</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderSoft">#1B2534</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="BgWindow">#F4F6FA</SolidColorBrush>
                    <SolidColorBrush x:Key="BgSurface">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BgElevated">#EDF1F7</SolidColorBrush>
                    <SolidColorBrush x:Key="BgBar">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BgInput">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="TextPrimary">#0F172A</SolidColorBrush>
                    <SolidColorBrush x:Key="TextSecondary">#475569</SolidColorBrush>
                    <SolidColorBrush x:Key="TextMuted">#94A3B8</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderColor">#DCE3EC</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderSoft">#E8EDF4</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Акцент и его оттенки перезаписываются на ходу из «Внешнего
                 вида»; здесь — значения до первого выбора. -->
            <SolidColorBrush x:Key="Accent">#3B82F6</SolidColorBrush>
            <Color x:Key="AccentColor">#3B82F6</Color>
            <SolidColorBrush x:Key="AccentSoft" Color="#3B82F6" Opacity="0.16" />
            <SolidColorBrush x:Key="AccentGhost" Color="#3B82F6" Opacity="0.08" />
            <SolidColorBrush x:Key="Warning">#F59E0B</SolidColorBrush>
            <SolidColorBrush x:Key="Danger">#F43F5E</SolidColorBrush>
            <SolidColorBrush x:Key="Success">#10B981</SolidColorBrush>
            <x:Double x:Key="ChatFontSize">15</x:Double>

            <FontFamily x:Key="Face">avares://Avalonia.Fonts.Inter/Assets#Inter</FontFamily>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <mi:MaterialIconStyles />

        <Style Selector="UserControl, Window">
            <Setter Property="FontFamily" Value="{StaticResource Face}" />
        </Style>

        <!-- ==================== Кнопки ====================

             Фон задаётся содержимому внутри шаблона, а не самой кнопке: Fluent
             красит именно ContentPresenter и Background снаружи перекрывает —
             кнопка остаётся серой, как ни задавай цвет. -->

        <Style Selector="Button">
            <!-- 48 точек: по меньшей кнопке промахиваются пальцем на ходу. -->
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="FontFamily" Value="{StaticResource Face}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <!-- CornerRadius здесь не задаётся нарочно: Fluent связывает его с
             самой кнопкой, и жёсткое значение сломало бы круглые кнопки — та,
             что отправляет команду, перестала бы быть кругом. -->
        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgElevated}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.accent /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Нажатие должно быть видно: на телефоне это единственный отклик —
             курсора нет, и без него непонятно, попал палец или нет. -->
        <Style Selector="Button:pressed">
            <Setter Property="Opacity" Value="0.7" />
        </Style>

        <Style Selector="Button.soft /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>

        <Style Selector="Button.soft">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.quiet /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.quiet">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <!-- ==================== Поля ==================== -->

        <Style Selector="TextBox">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{DynamicResource BgInput}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="{StaticResource Face}" />
            <Setter Property="Padding" Value="16,12" />
        </Style>

        <!-- Поле в фокусе обведено акцентом: на телефоне открыта клавиатура, и
             из-под неё виден лишь край экрана — надо понимать, куда пишешь. -->
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="1.5" />
        </Style>

        <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        </Style>

        <!-- ==================== Карточка ====================
             Одна форма для всего сгруппированного: скругление, мягкая граница
             вместо жирной рамки, тень, дающая слой. -->

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource BgSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="BoxShadow" Value="0 2 14 0 #22000000" />
        </Style>

        <!-- ==================== Текст ==================== -->

        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Face}" />
        </Style>

        <Style Selector="SelectableTextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Face}" />
        </Style>

        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="-0.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <!-- Подпись раздела: мелкая, разреженная, приглушённая. Она называет
             группу, а не соревнуется с ней за внимание. -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <Style Selector="TextBlock.body">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="ToggleSwitch">
            <Setter Property="FontFamily" Value="{StaticResource Face}" />
        </Style>
    </Application.Styles>
</Application>
