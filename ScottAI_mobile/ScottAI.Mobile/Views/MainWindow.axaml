<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ScottAI.Mobile.Views"
        x:Class="ScottAI.Mobile.Views.MainWindow"
        Icon="/Assets/scott.ico"
        Title="ScottAI на телефоне"
        Background="{DynamicResource BgWindow}"
        Width="390" Height="800">

    <!-- Окно нужно ровно для одного: видеть, что получается, не доставая
         телефон. Размер — как у обычного телефона, чтобы разметка проверялась
         в тех же условиях, в каких будет жить.

         Менять его можно: узкие экраны встречаются, и ломаться на них
         приложение не должно. -->

    <views:MainView />
</Window>
