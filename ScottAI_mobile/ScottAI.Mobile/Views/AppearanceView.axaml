<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Mobile.ViewModels"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:DataType="vm:AppearanceViewModel"
             x:Class="ScottAI.Mobile.Views.AppearanceView">

    <!-- Внешний вид. Всё применяется сразу: выбор цвета проверяют глазами. -->

    <ScrollViewer Padding="16,16,10,20">
        <StackPanel Spacing="22">

            <!-- ==================== Цвет ==================== -->

            <StackPanel Spacing="11">
                <TextBlock Text="АКЦЕНТНЫЙ ЦВЕТ" Classes="label" />

                <Border Classes="card" Padding="14,14">
                    <StackPanel Spacing="12">
                        <ItemsControl ItemsSource="{Binding Accents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AccentChoice">
                                    <Button Classes="quiet" Margin="0,0,6,6" Padding="4"
                                            MinHeight="0" CornerRadius="19"
                                            Command="{Binding $parent[ItemsControl].((vm:AppearanceViewModel)DataContext).ChooseCommand}"
                                            CommandParameter="{Binding Hex}"
                                            ToolTip.Tip="{Binding Name}">
                                        <!-- Выбранный обведён кольцом и помечен
                                             галочкой. Одного кольца мало: тот, кто
                                             не различает эти цвета, увидит семь
                                             одинаковых кружков. -->
                                        <Panel Width="46" Height="46">
                                            <Ellipse Width="46" Height="46"
                                                     Stroke="{DynamicResource TextPrimary}"
                                                     StrokeThickness="2"
                                                     IsVisible="{Binding Selected}" />
                                            <Border Width="36" Height="36" CornerRadius="18"
                                                    Background="{Binding Brush}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            <mi:MaterialIcon Kind="Check" Width="18" Height="18"
                                                             Foreground="White"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"
                                                             IsVisible="{Binding Selected}" />
                                        </Panel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding AccentName}" FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Accent}" />
                            <TextBlock Classes="hint"
                                       Text="Тот же набор, что в Scott на компьютере: это одна вещь на двух экранах." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ==================== Тема ==================== -->

            <StackPanel Spacing="11">
                <TextBlock Text="ТЕМА" Classes="label" />

                <Border Classes="card">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="13"
                                Background="{DynamicResource AccentSoft}" VerticalAlignment="Center">
                            <mi:MaterialIcon Kind="WeatherNight" Width="19" Height="19"
                                             Foreground="{DynamicResource Accent}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             IsVisible="{Binding Dark}" />
                        </Border>
                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="13"
                                Background="{DynamicResource AccentSoft}" VerticalAlignment="Center"
                                IsVisible="{Binding !Dark}">
                            <mi:MaterialIcon Kind="WhiteBalanceSunny" Width="19" Height="19"
                                             Foreground="{DynamicResource Accent}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Тёмная" Classes="h2" />
                            <TextBlock Classes="hint"
                                       Text="По умолчанию: телефон чаще берут в руки вечером." />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding Dark}"
                                      OnContent="" OffContent=""
                                      VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ==================== Размер текста ==================== -->

            <StackPanel Spacing="11">
                <TextBlock Text="РАЗМЕР ТЕКСТА" Classes="label" />

                <Border Classes="card">
                    <StackPanel Spacing="14">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock Grid.Column="0" Text="А" FontSize="13"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}" />
                            <Slider Grid.Column="1" Minimum="0.85" Maximum="1.45"
                                    Value="{Binding FontScale}"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="А" FontSize="21"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}" />
                        </Grid>

                        <!-- Пример тут же: проверять размер на настоящей реплике
                             честнее, чем на числе процентов. -->
                        <StackPanel Spacing="8">
                            <Border CornerRadius="20,20,6,20" Padding="15,10"
                                    HorizontalAlignment="Right" MaxWidth="240"
                                    Background="{DynamicResource Accent}">
                                <TextBlock Text="открой браузер" TextWrapping="Wrap"
                                           FontSize="{DynamicResource ChatFontSize}"
                                           Foreground="White" />
                            </Border>

                            <Border CornerRadius="20,20,20,6" Padding="15,10"
                                    HorizontalAlignment="Left" MaxWidth="240"
                                    Background="{DynamicResource BgElevated}">
                                <TextBlock Text="Открыл" TextWrapping="Wrap"
                                           FontSize="{DynamicResource ChatFontSize}"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Classes="hint"
                                   Text="Телефон держат дальше от глаз, чем монитор, — и читают на ходу." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
