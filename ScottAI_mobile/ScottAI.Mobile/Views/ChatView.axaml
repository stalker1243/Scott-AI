<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Mobile.ViewModels"
             xmlns:models="using:ScottAI.Mobile.Models"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:DataType="vm:ChatViewModel"
             x:Class="ScottAI.Mobile.Views.ChatView">

    <!-- Чат со Scott.

         Написанное здесь выполняется на домашнем компьютере, в пустой комнате.
         Поэтому реплики Scott бывают трёх видов, и различить их нужно с одного
         взгляда: обычный ответ, отказ (издалека он делает не всё, что умеет) и
         сбой связи (команда могла не дойти). -->

    <Grid RowDefinitions="*,Auto">

        <!-- ==================== Лента ==================== -->

        <Panel Grid.Row="0">

          <!-- Пустой экран держится по центру, а не под шапкой: прижатый к
               верху, он оставляет под собой пустоту в пол-экрана. -->
          <ScrollViewer Padding="20,14" IsVisible="{Binding Empty}">
            <StackPanel Spacing="18" Margin="4,0" VerticalAlignment="Center"
                        IsVisible="{Binding Empty}">

                <Border Width="72" Height="72" CornerRadius="26"
                        HorizontalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="{DynamicResource AccentColor}" Offset="0" />
                        <GradientStop Color="#0B2C6B" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <mi:MaterialIcon Kind="MicrophoneMessage" Width="34" Height="34"
                                 Foreground="White"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Spacing="7">
                    <TextBlock Text="Scott слушает" Classes="h1"
                           HorizontalAlignment="Center" />
                    <TextBlock Classes="hint" HorizontalAlignment="Center"
                           TextAlignment="Center" MaxWidth="280"
                           Text="Команды выполняются на домашнем компьютере — даже если вас там нет."
                           IsVisible="{Binding Paired}" />
                    <TextBlock Classes="hint" HorizontalAlignment="Center"
                           TextAlignment="Center" MaxWidth="280"
                           Text="Телефон ещё не связан с компьютером. Откройте «Связь» внизу — привязка занимает минуту."
                           IsVisible="{Binding !Paired}" />
                </StackPanel>

                <StackPanel Spacing="9" IsVisible="{Binding Paired}" Margin="0,8,0,0">
                    <TextBlock Text="ПОПРОБУЙТЕ" Classes="label" HorizontalAlignment="Center" />

                    <ItemsControl ItemsSource="{Binding Hints}">
                        <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Margin="0,0,0,8" HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left" Padding="16,13"
                                    Command="{Binding $parent[ItemsControl].((vm:ChatViewModel)DataContext).UseHintCommand}"
                                    CommandParameter="{Binding}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <mi:MaterialIcon Grid.Column="0" Kind="ArrowTopRight"
                                                 Width="16" Height="16"
                                                 VerticalAlignment="Center"
                                                 Foreground="{DynamicResource Accent}" />
                                    <TextBlock Grid.Column="1" Text="{Binding}"
                                           TextWrapping="Wrap" FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <ScrollViewer Padding="16,14,10,14" IsVisible="{Binding !Empty}">
            <StackPanel Spacing="12">

                <!-- Пустой чат.

                     Мигающий курсор без единой подсказки — худшее начало: Scott
                     понимает не всё подряд, и угадывать это человек не обязан.
                     Поэтому пустой экран показывает, что тут вообще можно
                     сказать, а до привязки — куда идти. -->

                <!-- Реплики -->

                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatMessage">
                            <Grid Margin="0,2">

                                <!-- Своё справа, ответ слева — как в любом
                                     мессенджере. Здесь это не подражание: так
                                     видно, где просьба, а где то, что из неё
                                     вышло. -->
                                <Border HorizontalAlignment="Right" MaxWidth="290"
                                        CornerRadius="20,20,6,20" Padding="16,11"
                                        Background="{DynamicResource Accent}"
                                        IsVisible="{Binding Mine}">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                   FontSize="{DynamicResource ChatFontSize}"
                                                   Foreground="White" />
                                        <TextBlock Text="{Binding TimeText}" FontSize="10"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#B0FFFFFF" />
                                    </StackPanel>
                                </Border>

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9"
                                      HorizontalAlignment="Left" MaxWidth="310"
                                      IsVisible="{Binding Theirs}">

                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="10"
                                            VerticalAlignment="Top" Margin="0,2,0,0"
                                            Background="{DynamicResource AccentSoft}">
                                        <TextBlock Text="S" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource Accent}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <Border Grid.Column="1" CornerRadius="20,20,20,6" Padding="16,11"
                                            Background="{DynamicResource BgSurface}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource BorderSoft}">
                                        <StackPanel Spacing="6">

                                            <!-- Отказ и сбой подписаны словами, а не
                                                 только цветом: цвет не читается при
                                                 ярком солнце и ничего не говорит
                                                 тому, кто его не различает. -->
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        IsVisible="{Binding Refused}">
                                                <mi:MaterialIcon Kind="ShieldAlertOutline"
                                                                 Width="14" Height="14"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Warning}" />
                                                <TextBlock Text="Scott не стал этого делать"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Warning}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        IsVisible="{Binding Failed}">
                                                <mi:MaterialIcon Kind="CloudOffOutline"
                                                                 Width="14" Height="14"
                                                                 VerticalAlignment="Center"
                                                                 Foreground="{DynamicResource Danger}" />
                                                <TextBlock Text="Команда не дошла"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Danger}" />
                                            </StackPanel>

                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                       FontSize="{DynamicResource ChatFontSize}"
                                                       LineHeight="21"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="{Binding TimeText}" FontSize="10"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Ожидание показывается прямо в ленте: команда идёт до дома и
                     обратно, и без этого кажется, что нажатие потерялось. -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9" HorizontalAlignment="Left"
                      IsVisible="{Binding Busy}">
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="10"
                            Background="{DynamicResource AccentSoft}">
                        <TextBlock Text="S" FontSize="13" FontWeight="Bold"
                                   Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Column="1" CornerRadius="20,20,20,6" Padding="16,13"
                            Background="{DynamicResource BgSurface}" BorderThickness="1"
                            BorderBrush="{DynamicResource BorderSoft}">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource TextMuted}" />
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource TextMuted}" />
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource TextMuted}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
          </ScrollViewer>
        </Panel>

        <!-- ==================== Строка ввода ==================== -->

        <Border Grid.Row="1" Background="{DynamicResource BgBar}" Padding="14,12"
                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSoft}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <TextBox Grid.Column="0" Text="{Binding Input}" AcceptsReturn="False"
                         PlaceholderText="Что сделать дома?"
                         CornerRadius="24"
                         FontSize="{DynamicResource ChatFontSize}" />

                <Button Grid.Column="1" Classes="accent" Width="48" Height="48"
                        CornerRadius="24" Padding="0"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Command="{Binding SendCommand}" IsEnabled="{Binding !Busy}">
                    <mi:MaterialIcon Kind="ArrowUp" Width="21" Height="21" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
