<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ScottAI.Mobile.ViewModels"
             x:DataType="vm:SyncViewModel"
             x:Class="ScottAI.Mobile.Views.SyncView">

    <!-- Связь с компьютером.

         Раздел про доверие, а не про удобство, поэтому здесь сказано прямо и
         то, чего связь НЕ делает: вне дома этот путь не работает, а отвязка с
         телефона не убирает его из списка на компьютере. -->

    <ScrollViewer Padding="16,14">
        <StackPanel Spacing="16">

            <TextBlock Text="Связь" Classes="h1" />

            <!-- ==================== Пока не привязан ==================== -->

            <StackPanel Spacing="14" IsVisible="{Binding NotPaired}">
                <TextBlock Classes="hint"
                           Text="Откройте Scott на компьютере, раздел «Удалённо», нажмите «Показать код» — и впишите сюда адрес компьютера и этот код. Код живёт минуту." />

                <StackPanel Spacing="6">
                    <TextBlock Text="Адрес компьютера" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBox Text="{Binding Host}" PlaceholderText="192.168.1.5" />
                    <TextBlock Classes="hint"
                               Text="Это адрес в домашней сети. В Scott он показан там же, в разделе «Удалённо»." />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock Text="Код с экрана" FontSize="12"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBox Text="{Binding Code}" PlaceholderText="6 цифр" MaxLength="6"
                             FontSize="20" LetterSpacing="4" />
                </StackPanel>

                <Button Content="Привязать" Classes="accent" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding PairCommand}" IsEnabled="{Binding !Busy}" />
            </StackPanel>

            <!-- ==================== Уже привязан ==================== -->

            <StackPanel Spacing="14" IsVisible="{Binding Paired}">
                <Border Background="{DynamicResource BgSurface}" CornerRadius="14" Padding="16"
                        BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{DynamicResource Success}" />
                            <TextBlock Text="Связан с компьютером" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PairedHost}" FontSize="13"
                                   Foreground="{DynamicResource TextMuted}" />
                    </StackPanel>
                </Border>

                <Button Content="Проверить связь" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding CheckCommand}" IsEnabled="{Binding !Busy}" />

                <Button Content="Забыть привязку" Classes="quiet" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding ForgetCommand}" />
            </StackPanel>

            <!-- ==================== Что вышло ==================== -->

            <Border CornerRadius="12" Padding="14,11"
                    Background="{DynamicResource BgSurface}"
                    IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="13"
                           Foreground="{DynamicResource TextSecondary}" />
            </Border>

            <!-- ==================== Вне дома ====================
                 Сказать честно важнее, чем выглядеть всемогущим: человек,
                 который рассчитывал на команду из города и не получил её,
                 решит, что приложение сломано. -->

            <Border Background="{DynamicResource BgSurface}" CornerRadius="14" Padding="16"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                <StackPanel Spacing="8">
                    <TextBlock Text="А если вас нет дома" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Classes="hint"
                               Text="Отсюда команды идут напрямую по домашней сети — это быстро и ни через кого не проходит, но работает только дома. Из города Scott слушается через Telegram: напишите его боту, и он выполнит то же самое, по тем же правилам." />
                </StackPanel>
            </Border>

            <!-- ==================== Что можно издалека ==================== -->

            <Border Background="{DynamicResource BgSurface}" CornerRadius="14" Padding="16"
                    BorderThickness="1" BorderBrush="{DynamicResource BorderColor}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Что Scott сделает издалека" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Classes="hint"
                               Text="Запустит программу, откроет сайт или папку, найдёт в интернете, поставит напоминание, ответит на вопрос, откроет проект, отложит команду до вашего прихода." />
                    <TextBlock Classes="hint"
                               Text="Не станет: выключать и перезагружать компьютер, закрывать программы, удалять файлы, выполнять команды оболочки. Всё это требует, чтобы вы видели экран и могли остановить." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
