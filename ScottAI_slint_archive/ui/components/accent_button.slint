import { Theme } from "../theme.slint";
import { Icon, IconKind } from "icons.slint";

// Второстепенная (контурная) кнопка — для действий рядом с основной AccentButton.
export component GhostButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> has-icon: false;
    in property <IconKind> icon-kind: IconKind.bolt;

    callback clicked();

    height: 44px;
    min-width: 120px;

    border-radius: Theme.radius-sm;
    background: touch.pressed ? Theme.bg-elevated : transparent;
    border-width: 1px;
    border-color: !enabled ? Theme.border : touch.has-hover ? Theme.accent : Theme.border;

    animate background, border-color { duration: 150ms; }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => {
            if (root.enabled) { root.clicked(); }
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        padding-left: 16px;
        padding-right: 16px;

        if has-icon: Icon {
            kind: root.icon-kind;
            icon-color: root.enabled ? Theme.text-primary : Theme.text-muted;
            icon-size: 16px;
        }

        if root.text != "": Text {
            text: root.text;
            color: root.enabled ? Theme.text-primary : Theme.text-muted;
            font-size: 14px;
            font-weight: 600;
            font-family: Theme.font-family;
            vertical-alignment: center;
        }
    }
}
