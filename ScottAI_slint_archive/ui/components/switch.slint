import { Theme } from "../theme.slint";

export component ThemeSwitch inherits Rectangle {
    in property <bool> checked: false;
    in property <color> on-color: Theme.accent;
    callback toggled(bool);

    width: 50px;
    height: 26px;
    border-radius: self.height / 2;
    background: checked ? on-color : Theme.bg-elevated;
    border-width: 1px;
    border-color: checked ? on-color : Theme.border;

    animate background, border-color { duration: 180ms; easing: ease-in-out; }

    Rectangle {
        x: checked ? parent.width - self.width - 3px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: self.height / 2;
        background: white;
        drop-shadow-blur: 3px;
        drop-shadow-color: #00000055;
        drop-shadow-offset-y: 1px;

        animate x { duration: 180ms; easing: cubic-bezier(0.34, 1.56, 0.64, 1); }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.toggled(!root.checked); }
    }
}
