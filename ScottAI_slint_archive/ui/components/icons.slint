import { Theme } from "../theme.slint";

// Единый набор кастомных векторных иконок (line-icon стиль, все контуры — прямые
// линии в сетке 24x24) взамен эмодзи. Один параметризованный компонент, чтобы не
// плодить десятки файлов — вид переключается через IconKind.
export enum IconKind {
    home, chat, settings, profile, bolt, cpu, ram, processes, status,
    idea, trend, note, sparkle, attach, mic, send, window, glass-diamond,
    terminal, check, save, remove,
}

export component Icon inherits Path {
    in property <IconKind> kind: IconKind.home;
    in property <color> icon-color: Theme.text-primary;
    in property <length> icon-size: 20px;

    width: icon-size;
    height: icon-size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: icon-color;
    stroke-width: kind == IconKind.ram || kind == IconKind.processes ? 2.6px : 1.8px;
    fill: transparent;

    commands: kind == IconKind.home ? "M4 11 L12 4 L20 11 M6 10 L6 20 L18 20 L18 10 M10 20 L10 13 L14 13 L14 20"
        : kind == IconKind.chat ? "M4 5 L20 5 L20 15 L9 15 L5 19 L5 15 L4 15 Z"
        : kind == IconKind.settings ? "M4 7 L20 7 M4 12 L20 12 M4 17 L20 17 M15 4.8 L17.2 7 L15 9.2 L12.8 7 Z M9 9.8 L11.2 12 L9 14.2 L6.8 12 Z M17 14.8 L19.2 17 L17 19.2 L14.8 17 Z"
        : kind == IconKind.profile ? "M15.5 8 L14.5 10.5 L12 11.5 L9.5 10.5 L8.5 8 L9.5 5.5 L12 4.5 L14.5 5.5 Z M5 20 L7 14 L17 14 L19 20"
        : kind == IconKind.bolt ? "M13 2 L4 14 L11 14 L10 22 L20 10 L13 10 Z"
        : kind == IconKind.cpu ? "M7 7 L17 7 L17 17 L7 17 Z M9 7 L9 4 M12 7 L12 4 M15 7 L15 4 M9 17 L9 20 M12 17 L12 20 M15 17 L15 20 M7 9 L4 9 M7 12 L4 12 M7 15 L4 15 M17 9 L20 9 M17 12 L20 12 M17 15 L20 15"
        : kind == IconKind.ram ? "M5 20 L5 13 M12 20 L12 9 M19 20 L19 15"
        : kind == IconKind.processes ? "M4 6 L20 6 M4 12 L20 12 M4 18 L20 18"
        : kind == IconKind.status ? "M19 12 L16.9 16.9 L12 19 L7.1 16.9 L5 12 L7.1 7.1 L12 5 L16.9 7.1 Z M12 5 L12 2"
        : kind == IconKind.idea ? "M17.2 10 L15.2 14.2 L12 16 L8.8 14.2 L6.8 10 L8.8 5.8 L12 4 L15.2 5.8 Z M10 18 L14 18 M10 20 L14 20"
        : kind == IconKind.trend ? "M3 17 L9 11 L13 15 L21 5 M21 5 L21 9 M21 5 L17 5"
        : kind == IconKind.note ? "M6 4 L18 4 L18 20 L6 20 Z M9 8 L15 8 M9 12 L15 12 M9 16 L13 16"
        : kind == IconKind.sparkle ? "M12 2 L14 10 L22 12 L14 14 L12 22 L10 14 L2 12 L10 10 Z"
        : kind == IconKind.attach ? "M12 5 L12 19 M5 12 L19 12"
        : kind == IconKind.mic ? "M9 4 L15 4 L15 12 L9 12 Z M6 10 L6 12 L18 12 L18 10 M12 12 L12 18 M8 20 L16 20"
        : kind == IconKind.send ? "M4 12 L20 12 M14 6 L20 12 L14 18"
        : kind == IconKind.window ? "M4 5 L20 5 L20 19 L4 19 Z M4 9 L20 9"
        : kind == IconKind.glass-diamond ? "M12 3 L21 12 L12 21 L3 12 Z"
        : kind == IconKind.terminal ? "M5 6 L11 12 L5 18 M13 18 L19 18"
        : kind == IconKind.check ? "M4 12 L9 17 L20 6"
        : kind == IconKind.save ? "M5 4 L17 4 L20 7 L20 20 L5 20 Z M8 4 L8 9 L16 9 L16 4 M8 14 L16 14 L16 20 L8 20 Z"
        : kind == IconKind.remove ? "M6 6 L18 18 M18 6 L6 18"
        : "";
}
