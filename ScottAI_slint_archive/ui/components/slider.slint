import { Theme } from "../theme.slint";

// Горизонтальный слайдер 0.0–1.0 (перетаскивание и клик по дорожке).
// Используется для регулировки уровня прозрачности стиля Glass в настройках.
export component Slider inherits Rectangle {
    in property <float> value: 0.5;
    callback changed(float);

    height: 26px;

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: 6px;
        width: 100%;
        border-radius: 3px;
        background: Theme.bg-elevated;
        border-width: 1px;
        border-color: Theme.border;
    }

    fill := Rectangle {
        x: track.x;
        y: track.y;
        height: track.height;
        width: max(6px, parent.width * root.value);
        border-radius: 3px;
        background: Theme.accent;
    }

    handle := Rectangle {
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: white;
        border-width: 2px;
        border-color: Theme.accent;
        x: max(0px, min(parent.width - self.width, root.value * parent.width - self.width / 2));
        y: (parent.height - self.height) / 2;
        drop-shadow-blur: touch.pressed ? 8px : 4px;
        drop-shadow-color: #00000066;
        drop-shadow-offset-y: 1px;

        animate drop-shadow-blur { duration: 120ms; }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;

        moved => {
            if (self.pressed) {
                root.changed(max(0.0, min(1.0, self.mouse-x / self.width)));
            }
        }

        clicked => {
            root.changed(max(0.0, min(1.0, self.mouse-x / self.width)));
        }
    }
}
