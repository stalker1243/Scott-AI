import { Theme } from "../theme.slint";

// Тонкий декоративный индикатор прокрутки для списков внутри Flickable.
// viewport-height — полная прокручиваемая высота содержимого,
// visible-height — видимая высота области, offset — текущий сдвиг (Flickable.viewport-y, отрицательный).
export component ScrollIndicator inherits Rectangle {
    in property <length> viewport-height: 1px;
    in property <length> visible-height: 1px;
    in property <length> offset: 0px;

    width: 4px;
    background: transparent;

    Rectangle {
        y: viewport-height > visible-height
            ? (-offset / viewport-height) * parent.height
            : 0px;
        width: 4px;
        height: viewport-height > visible-height
            ? max(24px, (visible-height / viewport-height) * parent.height)
            : parent.height;
        border-radius: 2px;
        background: Theme.border;
        opacity: viewport-height > visible-height ? 1.0 : 0.0;

        animate opacity { duration: 200ms; }
    }
}
