import { Theme } from "../theme.slint";
import { Icon, IconKind } from "icons.slint";

export component GlassCard inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <color> accent-color: Theme.accent;
    in property <bool> has-icon: false;
    in property <IconKind> icon-kind: IconKind.status;

    width: 220px;
    height: 120px;

    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.bg-elevated : Theme.bg-surface;
    border-width: 1px;
    border-color: touch.has-hover ? accent-color : Theme.border;
    clip: true;

    drop-shadow-blur: Theme.is-glass ? 0px : 10px;
    drop-shadow-color: Theme.is-glass ? transparent : Theme.shadow;
    drop-shadow-offset-y: 4px;

    animate background, border-color { duration: 180ms; }

    touch := TouchArea {
        width: 100%;
        height: 100%;
    }

    Rectangle {
        x: 0px;
        y: 0px;
        width: 4px;
        height: parent.height;
        background: accent-color;
    }

    VerticalLayout {
        padding: 18px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 8px;

            if has-icon: Icon {
                kind: root.icon-kind;
                icon-color: accent-color;
                icon-size: 16px;
            }

            Text {
                text: root.title;
                color: Theme.text-secondary;
                font-size: 13px;
                font-weight: 600;
                font-family: Theme.font-family;
            }
        }

        Text {
            text: root.value;
            color: Theme.text-primary;
            font-size: 28px;
            font-weight: 700;
            font-family: Theme.font-family;
        }
    }
}
