import { Theme, AppStyle } from "../theme.slint";
import { ThemeSwitch } from "../components/switch.slint";
import { Slider } from "../components/slider.slint";
import { Icon, IconKind } from "../components/icons.slint";

component StyleCard inherits Rectangle {
    in property <string> name;
    in property <IconKind> preview-icon;
    in property <color> preview-bg;
    in property <color> preview-accent;
    in property <bool> selected: false;
    callback clicked();

    width: 190px;
    height: 150px;
    border-radius: Theme.radius-md;
    background: preview-bg;
    border-width: selected ? 2px : 1px;
    border-color: selected ? Theme.accent : (touch.has-hover ? Theme.accent.with-alpha(0.5) : Theme.border);

    drop-shadow-blur: selected ? 14px : (touch.has-hover ? 6px : 0px);
    drop-shadow-color: Theme.accent.with-alpha(0.4);
    opacity: touch.pressed ? 0.85 : 1.0;

    animate border-color, drop-shadow-blur, opacity { duration: 150ms; easing: ease-out; }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }

    VerticalLayout {
        padding: 16px;
        spacing: 8px;
        alignment: space-between;

        HorizontalLayout {
            alignment: space-between;
            Icon {
                kind: root.preview-icon;
                icon-color: white;
                icon-size: 22px;
            }
            if selected: Icon {
                kind: IconKind.check;
                icon-color: Theme.accent;
                icon-size: 18px;
            }
        }

        Rectangle {
            height: 24px;
            border-radius: 6px;
            background: preview-accent;
        }

        Text {
            text: root.name;
            color: white;
            font-size: 15px;
            font-weight: 700;
        }
    }
}

component AccentSwatch inherits Rectangle {
    in property <color> swatch-color;
    in property <bool> selected: false;
    callback clicked();

    width: 36px;
    height: 36px;
    border-radius: 18px;
    background: swatch-color;
    border-width: selected ? 3px : (touch.has-hover ? 2px : 0px);
    border-color: selected ? white : white.with-alpha(0.6);

    drop-shadow-blur: selected ? 8px : (touch.has-hover ? 5px : 0px);
    drop-shadow-color: swatch-color;
    opacity: touch.pressed ? 0.8 : 1.0;

    animate border-width, drop-shadow-blur, opacity { duration: 150ms; easing: ease-out; }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.clicked();
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <AppStyle> current-style: AppStyle.classic;
    in property <bool> dark-mode: true;
    in property <color> accent: Theme.accent;
    in property <float> glass-opacity: 0.35;
    in property <string> backend-url: "";

    callback style-selected(AppStyle);
    callback dark-mode-toggled(bool);
    callback accent-selected(color);
    callback glass-opacity-changed(float);

    background: transparent;

    Flickable {
        viewport-height: content.preferred-height + 60px;

        content := VerticalLayout {
            padding: 40px;
            spacing: 32px;

            Text {
                text: "Настройки";
                color: Theme.text-primary;
                font-size: 30px;
                font-weight: 700;
                font-family: Theme.font-family;
            }

            VerticalLayout {
                spacing: 14px;

                Text {
                    text: "Стиль лаунчера";
                    color: Theme.text-secondary;
                    font-size: 15px;
                    font-weight: 600;
                    font-family: Theme.font-family;
                }

                HorizontalLayout {
                    spacing: 16px;

                    StyleCard {
                        name: "Classic";
                        preview-icon: IconKind.window;
                        preview-bg: #1f2937;
                        preview-accent: #3b82f6;
                        selected: root.current-style == AppStyle.classic;
                        clicked => { root.style-selected(AppStyle.classic); }
                    }

                    StyleCard {
                        name: "Glass";
                        preview-icon: IconKind.glass-diamond;
                        preview-bg: #0b1220;
                        preview-accent: #60a5fa;
                        selected: root.current-style == AppStyle.glass;
                        clicked => { root.style-selected(AppStyle.glass); }
                    }

                    StyleCard {
                        name: "Terminal Pro";
                        preview-icon: IconKind.terminal;
                        preview-bg: #05070a;
                        preview-accent: #00fff2;
                        selected: root.current-style == AppStyle.terminal-pro;
                        clicked => { root.style-selected(AppStyle.terminal-pro); }
                    }
                }
            }

            if root.current-style == AppStyle.classic: HorizontalLayout {
                alignment: space-between;

                VerticalLayout {
                    spacing: 2px;
                    alignment: center;
                    Text {
                        text: "Тёмная тема";
                        color: Theme.text-primary;
                        font-size: 15px;
                        font-weight: 600;
                        font-family: Theme.font-family;
                    }
                    Text {
                        text: "Только для стиля Classic";
                        color: Theme.text-muted;
                        font-size: 12px;
                        font-family: Theme.font-family;
                    }
                }

                ThemeSwitch {
                    checked: root.dark-mode;
                    toggled(v) => { root.dark-mode-toggled(v); }
                }
            }

            if root.current-style == AppStyle.glass: VerticalLayout {
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Прозрачность";
                        color: Theme.text-primary;
                        font-size: 15px;
                        font-weight: 600;
                        font-family: Theme.font-family;
                    }

                    Text {
                        text: round(root.glass-opacity * 100) + "%";
                        color: Theme.text-secondary;
                        font-size: 14px;
                        font-weight: 600;
                        font-family: Theme.font-family;
                    }
                }

                Text {
                    text: "Насколько сильно виден рабочий стол сквозь лаунчер";
                    color: Theme.text-muted;
                    font-size: 12px;
                    font-family: Theme.font-family;
                }

                Slider {
                    value: root.glass-opacity;
                    changed(v) => { root.glass-opacity-changed(v); }
                }
            }

            VerticalLayout {
                spacing: 14px;

                Text {
                    text: "Цветовой акцент";
                    color: Theme.text-secondary;
                    font-size: 15px;
                    font-weight: 600;
                    font-family: Theme.font-family;
                }

                HorizontalLayout {
                    spacing: 14px;

                    AccentSwatch { swatch-color: #3b82f6; selected: root.accent == #3b82f6; clicked => { root.accent-selected(#3b82f6); } }
                    AccentSwatch { swatch-color: #22c55e; selected: root.accent == #22c55e; clicked => { root.accent-selected(#22c55e); } }
                    AccentSwatch { swatch-color: #a855f7; selected: root.accent == #a855f7; clicked => { root.accent-selected(#a855f7); } }
                    AccentSwatch { swatch-color: #f59e0b; selected: root.accent == #f59e0b; clicked => { root.accent-selected(#f59e0b); } }
                    AccentSwatch { swatch-color: #ef4444; selected: root.accent == #ef4444; clicked => { root.accent-selected(#ef4444); } }
                    AccentSwatch { swatch-color: #00fff2; selected: root.accent == #00fff2; clicked => { root.accent-selected(#00fff2); } }
                    AccentSwatch { swatch-color: #ff2bd6; selected: root.accent == #ff2bd6; clicked => { root.accent-selected(#ff2bd6); } }
                }
            }

            VerticalLayout {
                spacing: 6px;

                Text {
                    text: "Backend";
                    color: Theme.text-secondary;
                    font-size: 15px;
                    font-weight: 600;
                    font-family: Theme.font-family;
                }

                Text {
                    text: root.backend-url;
                    color: Theme.text-muted;
                    font-size: 13px;
                    font-family: Theme.font-family;
                }
            }
        }
    }
}
