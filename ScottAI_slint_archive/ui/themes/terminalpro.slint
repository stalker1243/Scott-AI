// Terminal Pro — тёмный фон + яркие неоновые акценты, шрифт-моноспейс для консольного духа.

export global TerminalPro {
    out property <color> bg-window: #05070a;
    out property <color> bg-sidebar: #090c11;
    out property <color> bg-topbar: #090c11;
    out property <color> bg-surface: #0d1117;
    out property <color> bg-elevated: #131a23;
    out property <color> text-primary: #e6faff;
    out property <color> text-secondary: #7fe7ff;
    out property <color> text-muted: #4a6572;
    out property <color> border: #00fff233;
    out property <color> shadow: #00fff21a;

    // Неоновая палитра, доступная поверх обычных токенов Theme
    out property <color> neon-cyan: #00fff2;
    out property <color> neon-magenta: #ff2bd6;
    out property <color> neon-green: #00ff9c;
    out property <color> neon-amber: #ffb800;
}
