// Classic — стиль обычного Windows-приложения. Имеет светлый и тёмный подрежим,
// переключаемые независимо от выбора стиля (Theme.dark-mode).

export global ClassicLight {
    out property <color> bg-window: #f1f2f5;
    out property <color> bg-sidebar: #ffffff;
    out property <color> bg-topbar: #ffffff;
    out property <color> bg-surface: #ffffff;
    out property <color> bg-elevated: #f3f4f6;
    out property <color> text-primary: #111827;
    out property <color> text-secondary: #6b7280;
    out property <color> text-muted: #9ca3af;
    out property <color> border: #e2e5eb;
    out property <color> shadow: #00000022;
}

export global ClassicDark {
    out property <color> bg-window: #10161f;
    out property <color> bg-sidebar: #0d1420;
    out property <color> bg-topbar: #131b28;
    out property <color> bg-surface: #1a2332;
    out property <color> bg-elevated: #212c3d;
    out property <color> text-primary: #f3f4f6;
    out property <color> text-secondary: #9ca3af;
    out property <color> text-muted: #6b7280;
    out property <color> border: #2a3547;
    out property <color> shadow: #00000055;
}
